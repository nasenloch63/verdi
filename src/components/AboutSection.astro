---
import { Picture } from 'astro:assets';
import crustPhoto from '../assets/photos/pizza-steinofen-nah.jpg';
import tablePhoto from '../assets/photos/tisch-gemeinsam.jpg';
import melanzanePhoto from '../assets/photos/melanzane-parmigiana.jpg';
import { RESTAURANT } from '../data/restaurant';
---

<section id="ueber-uns" class="bg-surface-taupe relative scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- Visual Editorial Collage in Dark Smoked Walnut Mat Frames -->
      <div class="lg:col-span-6">
        <div class="grid grid-cols-12 gap-4">
          <div
            data-parallax="-18"
            class="wood-dark-bar col-span-12 overflow-hidden rounded-[1.6rem] border border-brass/35 p-1.5 shadow-[0_24px_50px_-20px_rgba(20,11,6,0.45)] sm:p-2"
          >
            <div class="overflow-hidden rounded-[1.2rem]">
              <Picture
                src={crustPhoto}
                formats={['avif', 'webp']}
                widths={[600, 960]}
                sizes="(max-width: 1024px) 100vw, 48vw"
                alt="Kross gebackene Steinofen-Pizza mit feinem Belag und charakteristisch gebräuntem Rand"
                class="aspect-[16/10] w-full object-cover object-[50%_75%]"
              />
            </div>
          </div>
          <div
            data-parallax="16"
            class="wood-dark-bar col-span-7 h-44 overflow-hidden rounded-[1.5rem] border border-brass/30 p-1.5 shadow-lg shadow-espresso/20 sm:h-56"
          >
            <div class="h-full w-full overflow-hidden rounded-[1.15rem]">
              <Picture
                src={tablePhoto}
                formats={['avif', 'webp']}
                widths={[400, 720]}
                sizes="(max-width: 1024px) 60vw, 28vw"
                alt="Gäste genießen frisch gebackene Pizzen bei Kerzenschein im Ristorante Verdi"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
          <div
            data-parallax="30"
            class="wood-dark-bar col-span-5 h-44 overflow-hidden rounded-[1.5rem] border border-brass/30 p-1.5 shadow-lg shadow-espresso/20 sm:h-56"
          >
            <div class="h-full w-full overflow-hidden rounded-[1.15rem]">
              <Picture
                src={melanzanePhoto}
                formats={['avif', 'webp']}
                widths={[320, 560]}
                sizes="(max-width: 1024px) 40vw, 20vw"
                alt="Melanzane alla Parmiggiana – überbackene Auberginen in Tomatensauce mit Mozzarella"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Story Copy -->
      <div data-stagger-group class="lg:col-span-6">
        <p data-stagger-item class="inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.22em] text-tomato">
          <span class="h-px w-6 bg-brass" aria-hidden="true"></span>
          <span>Über das Ristorante Verdi</span>
        </p>
        <h2 data-stagger-item class="mt-2 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl">
          Ehrliche Küche, heißer Steinofen &amp;{' '}
          <span class="italic font-normal text-wood-warm">faire Preise.</span>
        </h2>

        <p data-stagger-item class="mt-6 text-base leading-relaxed text-muted sm:text-lg">
          Im <strong class="font-semibold text-ink">Ristorante Verdi</strong> zählt das, was auf dem Teller
          landet: hauchdünner, knusprig gebackener Pizzateig direkt aus dem Steinofen,
          großzügige Portionen und klassische italienische Pasta- und Ofengerichte ohne Schnörkel.
        </p>

        <p data-stagger-item class="mt-4 text-base leading-relaxed text-muted">
          Ob Sie Ihre Lieblingspizza auf dem Heimweg blitzschnell abholen oder in entspannter,
          zwangloser Atmosphäre (Selbstbedienung am Tresen) vor Ort oder im Freien genießen:
          Bei uns bekommen Sie kompromisslose Frische zu einem Preis-Leistungs-Verhältnis,
          für das Gäste aus ganz Hessisch Lichtenau und Umgebung immer wiederkommen.
        </p>

        <!-- Three Interactive 3D Perspective Tilt Craft Pillars with Warm Wood Inlay Top Trim -->
        <div data-stagger-item class="mt-8 grid gap-4 sm:grid-cols-3">
          <div data-tilt-card class="linen-card rounded-2xl border border-sand transition-shadow hover:shadow-lg">
            <div class="wood-warm-cap h-1.5 w-full" aria-hidden="true"></div>
            <div class="p-4">
              <p class="font-display text-lg font-semibold text-walnut">Steinofen-Teig</p>
              <p class="mt-1 text-xs leading-relaxed text-muted">
                Schön dünn, kross gebacken und frisch belegt – von Ø 24 cm bis Ø 32 cm.
              </p>
            </div>
          </div>
          <div data-tilt-card class="linen-card rounded-2xl border border-sand transition-shadow hover:shadow-lg">
            <div class="wood-warm-cap h-1.5 w-full" aria-hidden="true"></div>
            <div class="p-4">
              <p class="font-display text-lg font-semibold text-walnut">Schnelle Abholung</p>
              <p class="mt-1 text-xs leading-relaxed text-muted">
                Kurz anrufen, bestellen und heiß mitnehmen – direkt gegenüber der Grundschule.
              </p>
            </div>
          </div>
          <div data-tilt-card class="linen-card rounded-2xl border border-sand transition-shadow hover:shadow-lg">
            <div class="wood-warm-cap h-1.5 w-full" aria-hidden="true"></div>
            <div class="p-4">
              <p class="font-display text-lg font-semibold text-walnut">Frischegarantie</p>
              <p class="mt-1 text-xs leading-relaxed text-muted">
                Ausschließlich frische Zutaten – von knackigen Salaten bis Pasta al Forno.
              </p>
            </div>
          </div>
        </div>

        <!-- Animated Count-Up Real Proof Bar -->
        <div data-stagger-item class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-taupe/70 pt-6">
          <div>
            <p
              class="font-display text-3xl font-bold tabular-nums text-tomato"
              data-count-to="4.7"
              data-count-decimals="1"
              data-count-suffix=" ★"
              data-count-display={`${RESTAURANT.rating.scoreDisplay} ★`}
            >
              {RESTAURANT.rating.scoreDisplay} ★
            </p>
            <p class="text-xs text-muted">{RESTAURANT.rating.fiveStarCount}× 5 Sterne bei Google</p>
          </div>
          <div>
            <p
              class="font-display text-3xl font-bold tabular-nums text-ink"
              data-count-to="216"
              data-count-decimals="0"
              data-count-suffix="+"
              data-count-display="216+"
            >
              216+
            </p>
            <p class="text-xs text-muted">Verifizierte Bewertungen</p>
          </div>
          <div>
            <p
              class="font-display text-3xl font-bold tabular-nums text-verdi"
              data-count-to="63"
              data-count-decimals="0"
              data-count-suffix=""
              data-count-display="63"
            >
              63
            </p>
            <p class="text-xs text-muted">Gerichte frisch zubereitet</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
