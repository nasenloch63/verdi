---
import { Picture } from 'astro:assets';
import crustPhoto from '../assets/photos/pizza-steinofen-nah.jpg';
import tablePhoto from '../assets/photos/tisch-gemeinsam.jpg';
import melanzanePhoto from '../assets/photos/melanzane-parmigiana.jpg';
import Icon from './Icon.astro';
import { RESTAURANT } from '../data/restaurant';

const totalReviews = RESTAURANT.rating.count;
const pillars = [
  {
    icon: 'oven',
    title: 'Teig aus dem Steinofen',
    text: 'Dünn ausgerollt, kross gebacken und frisch belegt. In Ø 24 cm oder Ø 32 cm.',
  },
  {
    icon: 'bag',
    title: 'Anrufen, abholen, fertig',
    text: 'Kurz durchklingeln, bestellen und heiß mitnehmen. Direkt gegenüber der Grundschule.',
  },
  {
    icon: 'basil',
    title: 'Frische Zutaten',
    text: 'Vom knackigen Salat bis zur überbackenen Pasta al Forno wird alles frisch zubereitet.',
  },
] as const;
---

<section id="ueber-uns" class="bg-surface-taupe relative scroll-mt-20 overflow-hidden py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- Photo collage: three prints laid over each other -->
      <div class="relative lg:col-span-6">
        <div class="relative mx-auto max-w-xl pb-24 sm:pb-28">
          <figure data-clip-reveal data-parallax="-14" class="overflow-hidden rounded-md shadow-[0_30px_60px_-26px_rgba(20,11,6,0.6)]">
            <Picture
              src={crustPhoto}
              formats={['avif', 'webp']}
              widths={[600, 960]}
              sizes="(max-width: 1024px) 100vw, 46vw"
              alt="Kross gebackene Steinofen-Pizza mit feinem Belag und charakteristisch gebräuntem Rand"
              class="aspect-[5/4] w-full object-cover object-[50%_75%]"
            />
          </figure>

          <figure data-snap-in data-parallax="18" class="snapshot absolute bottom-2 left-0 w-[46%] sm:-left-4" style="--tilt: -5deg">
            <span class="tape" aria-hidden="true"></span>
            <Picture
              src={tablePhoto}
              formats={['avif', 'webp']}
              widths={[320, 560]}
              sizes="(max-width: 1024px) 46vw, 22vw"
              alt="Gäste genießen frisch gebackene Pizzen bei Kerzenschein im Ristorante Verdi"
              class="aspect-[4/3] w-full object-cover"
            />
            <figcaption class="font-hand pt-2 text-center text-[1.35rem] leading-none text-walnut">Abends bei uns</figcaption>
          </figure>

          <figure data-snap-in data-parallax="32" class="snapshot absolute bottom-6 right-0 w-[40%] sm:-right-3" style="--tilt: 4deg; --tape-tilt: 5deg">
            <span class="tape" aria-hidden="true"></span>
            <Picture
              src={melanzanePhoto}
              formats={['avif', 'webp']}
              widths={[280, 480]}
              sizes="(max-width: 1024px) 40vw, 19vw"
              alt="Melanzane alla Parmiggiana – überbackene Auberginen in Tomatensauce mit Mozzarella"
              class="aspect-square w-full object-cover"
            />
            <figcaption class="font-hand pt-2 text-center text-[1.35rem] leading-none text-walnut">Melanzane</figcaption>
          </figure>

          <!-- Handwritten note with an arrow pointing at the crust -->
          <div class="pointer-events-none absolute -top-14 right-2 flex items-end gap-1 text-tomato sm:-top-[3.75rem] sm:right-6" aria-hidden="true">
            <span class="font-hand -rotate-3 text-[1.7rem] leading-none sm:text-[2rem]">so kross muss der Rand sein</span>
            <svg class="h-12 w-10 translate-y-7" viewBox="0 0 40 50" fill="none">
              <path data-draw d="M6 4c18 3 26 16 22 38M28 42l-9-7M28 42l6-10" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
            </svg>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <p class="kicker">Über uns</p>
        <h2 data-split class="mt-1 font-display text-4xl font-medium leading-[1.04] tracking-tight text-ink sm:text-[3.4rem]">
          Ehrliche Küche, heißer Steinofen,{' '}
          <span class="italic font-normal text-wood-warm">faire Preise.</span>
        </h2>

        <div data-stagger-group>
          <p data-stagger-item class="mt-7 text-lg leading-relaxed text-ink/85">
            Im <strong class="font-semibold text-ink">Ristorante Verdi</strong> zählt, was auf dem Teller
            landet: hauchdünner Pizzateig aus dem Steinofen, große Portionen und italienische
            Pasta- und Ofengerichte ohne Schnörkel.
          </p>

          <p data-stagger-item class="mt-4 text-base leading-relaxed text-muted">
            Holen Sie Ihre Lieblingspizza auf dem Heimweg ab oder essen Sie entspannt bei uns,
            drinnen oder im Freien. Bestellt wird am Tresen. Für dieses Preis-Leistungs-Verhältnis
            kommen Gäste aus ganz Hessisch Lichtenau immer wieder.
          </p>

          <!-- Three promises, each with its own drawn icon -->
          <ul class="mt-9 space-y-5">
            {pillars.map((p) => (
              <li data-stagger-item class="flex items-start gap-4">
                <span class="medallion h-14 w-14">
                  <Icon name={p.icon} size={30} />
                </span>
                <span>
                  <span class="block font-display text-[1.3rem] font-medium leading-tight text-walnut">{p.title}</span>
                  <span class="mt-1 block text-base leading-relaxed text-muted">{p.text}</span>
                </span>
              </li>
            ))}
          </ul>

          <!-- Real numbers, counted up on scroll -->
          <dl data-stagger-item class="mt-10 grid grid-cols-3 gap-4 border-t border-taupe/70 pt-7">
            <div>
              <dd class="flex items-center gap-1.5 font-display text-[2.6rem] font-medium leading-none tabular-nums text-tomato sm:text-5xl">
                <span data-count-to={RESTAURANT.rating.score} data-count-decimals="1" data-count-display={RESTAURANT.rating.scoreDisplay}>
                  {RESTAURANT.rating.scoreDisplay}
                </span>
                <Icon name="star" size={26} class="text-brass" />
              </dd>
              <dt class="mt-2 text-sm leading-snug text-muted">Sterne im Schnitt bei Google</dt>
            </div>
            <div>
              <dd
                class="font-display text-[2.6rem] font-medium leading-none tabular-nums text-ink sm:text-5xl"
                data-count-to={totalReviews}
                data-count-decimals="0"
                data-count-display={String(totalReviews)}
              >
                {totalReviews}
              </dd>
              <dt class="mt-2 text-sm leading-snug text-muted">Google-Bewertungen</dt>
            </div>
            <div>
              <dd
                class="font-display text-[2.6rem] font-medium leading-none tabular-nums text-verdi sm:text-5xl"
                data-count-to="63"
                data-count-decimals="0"
                data-count-display="63"
              >
                63
              </dd>
              <dt class="mt-2 text-sm leading-snug text-muted">Gerichte auf der Karte</dt>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
