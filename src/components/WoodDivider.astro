---
// Slim walnut rail between sections. (Both variants render the same plain rail now.)
interface Props {
  variant?: 'slim' | 'ornate';
}
---

<div aria-hidden="true" class="relative z-10 w-full select-none">
  <div class="wood-warm-rail h-2.5 w-full border-y border-brass/45 shadow-[0_2px_10px_rgba(20,11,6,0.22)] sm:h-3"></div>
</div>
