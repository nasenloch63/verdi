const body = ICONS[name];
---

<svg
  class={`ic ${className}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  aria-label={title}
  set:html={body}
/>
