---
interface Props {
  variant?: 'dark' | 'light';
  compact?: boolean;
}
const { variant = 'dark', compact = false } = Astro.props;
const textColor = variant === 'light' ? 'text-cream' : 'text-ink';
const subColor = variant === 'light' ? 'text-cream/80' : 'text-verdi';
const strokeColor = variant === 'light' ? '#FBF6EE' : '#1F4D36';
const dotColor = '#B82D1A';
---

<span class={`inline-flex items-center gap-3 select-none ${textColor}`}>
  <svg
    width={compact ? 44 : 54}
    height={compact ? 33 : 40}
    viewBox="0 0 68 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <ellipse cx="34" cy="24" rx="31" ry="20" stroke={strokeColor} stroke-width="1.6" />
    <ellipse cx="34" cy="24" rx="26.5" ry="16" stroke={strokeColor} stroke-width="0.85" stroke-dasharray="2 2.5" opacity="0.7" />
    <text
      x="34"
      y="30.5"
      text-anchor="middle"
      font-family="Cormorant Garamond Variable, Georgia, serif"
      font-style="italic"
      font-weight="700"
      font-size="24"
      fill={variant === 'light' ? '#FBF6EE' : '#1C1917'}
    >
      Verdi
    </text>
    <circle cx="57" cy="11" r="3.4" fill={dotColor} />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`font-display text-[0.7rem] font-semibold uppercase tracking-[0.24em] ${subColor}`}>
      Ristorante · Pizzeria
    </span>
    <span class={`font-display italic font-bold tracking-tight ${compact ? 'text-[1.45rem]' : 'text-[1.7rem]'}`}>
      Verdi
    </span>
  </span>
</span>
