---
interface Props {
  variant?: 'dark' | 'light';
  compact?: boolean;
}
const { variant = 'light', compact = false } = Astro.props;
const textColor = variant === 'light' ? 'text-cream' : 'text-ink';
const subColor = variant === 'light' ? 'text-brass-light' : 'text-wood-warm';
const stroke = variant === 'light' ? '#D8AE6E' : '#352216';
const scriptFill = variant === 'light' ? '#F6EFE6' : '#221610';
---

<span class={`inline-flex items-center gap-2.5 select-none ${textColor}`}>
  <svg
    width={compact ? 62 : 76}
    height={compact ? 42 : 52}
    viewBox="0 0 92 62"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <ellipse cx="46" cy="31" rx="44" ry="29" stroke={stroke} stroke-width="1.6" />
    <text
      x="46"
      y="42"
      text-anchor="middle"
      font-family="'Pinyon Script', 'Snell Roundhand', cursive"
      font-size="37"
      fill={scriptFill}
    >
      Verdi
    </text>
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`whitespace-nowrap font-display font-medium ${compact ? 'text-[0.95rem] sm:text-[1.05rem]' : 'text-[1.15rem]'}`}>
      Ristorante
    </span>
    <span class={`mt-1 whitespace-nowrap font-display italic ${compact ? 'text-[0.82rem] sm:text-[0.9rem]' : 'text-[0.98rem]'} ${subColor}`}>
      &amp; Pizzeria
    </span>
  </span>
</span>
