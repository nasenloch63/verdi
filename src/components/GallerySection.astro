---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import photoRucola from '../assets/photos/hero-pizza-rucola.jpg';
import photoSteinofen from '../assets/photos/pizza-steinofen-nah.jpg';
import photoCarbonara from '../assets/photos/spaghetti-carbonara.jpg';
import photoAlForno from '../assets/photos/pasta-al-forno.jpg';
import photoMelanzane from '../assets/photos/melanzane-parmigiana.jpg';
import photoSalatPizza from '../assets/photos/salat-und-pizza.jpg';
import photoPrimavera from '../assets/photos/insalata-primavera.jpg';
import photoMaccheroni from '../assets/photos/maccheroni-sauce.jpg';
import photoAuswahl from '../assets/photos/pizzen-auswahl.jpg';
import photoGastraum from '../assets/photos/gastraum-verdi.jpg';

// shape: 'wide' 4:3 · 'tall' 4:5 · 'square'
const rawItems = [
  { src: photoSteinofen, shape: 'wide', tilt: '-1.5deg', pos: 'object-[50%_75%]', title: 'Frisch aus dem Steinofen', caption: 'Dünner Teig, knusprig gebräunter Rand und reichhaltiger Belag.', alt: 'Nahaufnahme einer frisch gebackenen Steinofen-Pizza aus dem Ristorante Verdi' },
  { src: photoCarbonara, shape: 'tall', tilt: '1.6deg', pos: 'object-center', title: 'Spaghetti Carbonara', caption: 'Gäste-Favorit mit Speck, Zwiebeln, Ei und frisch gehobeltem Parmesan.', alt: 'Spaghetti Carbonara mit Parmesanspänen und Speck im Ristorante Verdi' },
  { src: photoGastraum, shape: 'wide', tilt: '-1deg', pos: 'object-left', title: 'Unser Gastraum', caption: 'Ruhig, gemütlich und zwanglos – direkt an der Desseler Straße 15.', alt: 'Blick in den gemütlichen Gastraum des Ristorante Verdi in Hessisch Lichtenau' },
  { src: photoAlForno, shape: 'square', tilt: '2deg', pos: 'object-center', title: 'Pasta al Forno', caption: 'Mit Käse goldbraun im Steinofen überbacken – alle Gerichte 8,50 €.', alt: 'Goldbraun mit Käse überbackene Pasta al Forno in der Auflaufform' },
  { src: photoRucola, shape: 'wide', tilt: '-2deg', pos: 'object-[50%_72%]', title: 'Pizza mit Rucola & Oliven', caption: 'Leuchtend rote Tomatensauce, knackiger Rucola und schwarze Oliven.', alt: 'Steinofen-Pizza belegt mit frischem Rucola und schwarzen Oliven' },
  { src: photoMelanzane, shape: 'tall', tilt: '1.2deg', pos: 'object-center', title: 'Melanzane alla Parmiggiana', caption: 'Überbackene Auberginen in fruchtiger Tomatensauce mit Mozzarella.', alt: 'Melanzane alla Parmiggiana – überbackene Auberginen in Tomatensauce' },
  { src: photoSalatPizza, shape: 'wide', tilt: '-1.4deg', pos: 'object-center', title: 'Salat & Pizza', caption: 'Knackige Salate der Saison und Pizza für einen entspannten Abend.', alt: 'Reichhaltiger Salat mit Champignons und Pizza im Hintergrund am Tisch' },
  { src: photoPrimavera, shape: 'square', tilt: '1.8deg', pos: 'object-center', title: 'Insalata Primavera', caption: 'Salat der Saison mit Rucola, Krabben, Champignons und warmem Brot.', alt: 'Insalata Primavera mit Krabben und frischem Salat' },
  { src: photoAuswahl, shape: 'wide', tilt: '-1.8deg', pos: 'object-center', title: 'Pizzen zum Teilen', caption: 'Große 32-cm-Pizzen für den gemütlichen Abend mit Freunden.', alt: 'Zwei frisch gebackene Steinofen-Pizzen auf dem Tisch' },
  { src: photoMaccheroni, shape: 'tall', tilt: '1.4deg', pos: 'object-center', title: 'Maccheroni aus der Pfanne', caption: 'Klassische italienische Pasta in aromatischer Sauce.', alt: 'Maccheroni Pasta in cremiger Tomaten-Champignonsauce auf weißem Teller' },
] as const;

const aspect = { wide: 'aspect-[4/3]', tall: 'aspect-[4/5]', square: 'aspect-square' } as const;

const galleryItems = await Promise.all(
  rawItems.map(async (item, idx) => {
    const full = await getImage({ src: item.src, width: 1440, format: 'webp', quality: 84 });
    return { ...item, index: idx, lightboxSrc: full.src };
  })
);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="galerie" class="bg-surface-beige relative scroll-mt-20 overflow-hidden py-18 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="kicker">Aus Küche und Gastraum</p>
        <h2 data-split class="mt-1 font-display text-4xl font-medium tracking-tight text-ink sm:text-[3.4rem] sm:leading-[1.02]">
          Appetit auf <span class="italic font-normal text-wood-warm">Verdi?</span>
        </h2>
      </div>

      <div class="flex items-center gap-5">
        <p class="font-display text-lg tabular-nums text-muted" aria-live="polite">
          <span id="strip-current" class="text-2xl font-medium text-ink">01</span> / {pad(galleryItems.length)}
        </p>
        <div class="flex gap-2.5">
          <button type="button" id="strip-prev" aria-label="Vorherige Fotos" class="inline-flex h-12 w-12 items-center justify-center rounded-full border-[1.5px] border-walnut/45 text-walnut transition-colors hover:bg-walnut hover:text-cream disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-walnut">
            <Icon name="arrow-left" size={20} />
          </button>
          <button type="button" id="strip-next" aria-label="Nächste Fotos" class="inline-flex h-12 w-12 items-center justify-center rounded-full border-[1.5px] border-walnut/45 text-walnut transition-colors hover:bg-walnut hover:text-cream disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-walnut">
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- One compact row of prints: drag, swipe or use the arrows -->
  <div id="photo-strip" class="strip no-scrollbar mt-4" tabindex="0" role="group" aria-label="Fotos aus dem Ristorante Verdi">
    {galleryItems.map((item) => (
      <figure data-strip-card class="strip-card snapshot" style={`--tilt: ${item.tilt}`}>
        <button
          type="button"
          data-lightbox-trigger={item.index}
          data-src={item.lightboxSrc}
          data-title={item.title}
          data-caption={item.caption}
          data-alt={item.alt}
          class="group relative block overflow-hidden focus-visible:outline-tomato"
          aria-label={`${item.title} vergrößern`}
        >
          <Picture
            src={item.src}
            formats={['avif', 'webp']}
            widths={[480, 840]}
            sizes="(max-width: 640px) 78vw, 520px"
            alt={item.alt}
            loading="lazy"
            draggable="false"
            class={`strip-photo w-auto object-cover transition-transform duration-700 group-hover:scale-[1.05] ${aspect[item.shape]} ${item.pos}`}
          />
          <span aria-hidden="true" class="pointer-events-none absolute right-2.5 top-2.5 hidden h-9 w-9 items-center justify-center rounded-full bg-cream text-walnut opacity-0 shadow-md transition-opacity duration-300 group-hover:opacity-100 sm:inline-flex">
            <Icon name="expand" size={16} />
          </span>
        </button>
        <figcaption class="font-hand px-1 pt-2.5 text-center text-[1.45rem] leading-none text-walnut">{item.title}</figcaption>
      </figure>
    ))}
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mt-3 h-[3px] overflow-hidden rounded-full bg-walnut/15" aria-hidden="true">
      <div id="strip-progress" class="h-full w-full origin-left scale-x-[0.1] rounded-full bg-tomato"></div>
    </div>
  </div>

  <dialog
    id="verdi-lightbox"
    aria-label="Foto in Großansicht"
    class="wood-dark-surface m-auto max-h-[92vh] w-[94vw] max-w-4xl overflow-hidden rounded-xl border border-brass/40 p-0 text-cream shadow-2xl backdrop:bg-[#100805]/88"
  >
    <div class="relative flex flex-col">
      <div class="flex items-center justify-between border-b border-brass/25 px-5 py-3.5">
        <div>
          <p id="lb-title" class="font-display text-xl font-medium text-cream"></p>
          <p id="lb-counter" class="text-sm text-brass-light"></p>
        </div>
        <button type="button" id="lb-close" aria-label="Großansicht schließen" class="inline-flex h-11 w-11 items-center justify-center rounded-full text-cream transition-colors hover:bg-cream/12">
          <Icon name="close" size={22} />
        </button>
      </div>

      <div class="relative flex items-center justify-center bg-black/45 p-2 sm:p-4">
        <button type="button" id="lb-prev" aria-label="Vorheriges Foto" class="absolute left-3 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full bg-cream text-walnut shadow-lg transition-colors hover:bg-tomato hover:text-cream">
          <Icon name="arrow-left" size={20} />
        </button>
        <img id="lb-img" src="" alt="" class="max-h-[68vh] w-auto rounded-md object-contain" />
        <button type="button" id="lb-next" aria-label="Nächstes Foto" class="absolute right-3 z-10 inline-flex h-12 w-12 items-center justify-center rounded-full bg-cream text-walnut shadow-lg transition-colors hover:bg-tomato hover:text-cream">
          <Icon name="arrow-right" size={20} />
        </button>
      </div>

      <p id="lb-caption" class="border-t border-brass/20 px-5 py-3.5 text-center text-base text-parchment/90"></p>
    </div>
  </dialog>
</section>

<script>
  function initStrip() {
    const strip = document.getElementById('photo-strip');
    if (!strip) return;
    const cards = Array.from(strip.querySelectorAll<HTMLElement>('[data-strip-card]'));
    const prev = document.getElementById('strip-prev') as HTMLButtonElement | null;
    const next = document.getElementById('strip-next') as HTMLButtonElement | null;
    const current = document.getElementById('strip-current');
    const progress = document.getElementById('strip-progress');

    const update = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      const ratio = max > 0 ? strip.scrollLeft / max : 0;
      if (progress) progress.style.transform = `scaleX(${0.1 + ratio * 0.9})`;
      if (prev) prev.disabled = strip.scrollLeft < 8;
      if (next) next.disabled = strip.scrollLeft > max - 8;
      if (current && cards.length) {
        const idx = Math.min(cards.length - 1, Math.round(ratio * (cards.length - 1)));
        current.textContent = String(idx + 1).padStart(2, '0');
      }
    };

    const step = (dir: number) => {
      strip.scrollBy({ left: dir * Math.max(320, strip.clientWidth * 0.7), behavior: 'smooth' });
    };
    if (prev) prev.onclick = () => step(-1);
    if (next) next.onclick = () => step(1);
    strip.onkeydown = (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    };
    strip.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Drag to scroll with a little throw (mouse only; touch scrolls natively)
    let down = false;
    let moved = 0;
    let startX = 0;
    let startLeft = 0;
    let lastX = 0;
    let velocity = 0;
    let raf = 0;

    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      moved = 0;
      startX = lastX = e.clientX;
      startLeft = strip.scrollLeft;
      velocity = 0;
      cancelAnimationFrame(raf);
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      if (moved > 6) strip.classList.add('is-dragging');
      velocity = e.clientX - lastX;
      lastX = e.clientX;
      strip.scrollLeft = startLeft - dx;
    });
    const release = () => {
      if (!down) return;
      down = false;
      const glide = () => {
        velocity *= 0.94;
        strip.scrollLeft -= velocity;
        if (Math.abs(velocity) > 0.6) raf = requestAnimationFrame(glide);
        else strip.classList.remove('is-dragging');
      };
      if (Math.abs(velocity) > 2) raf = requestAnimationFrame(glide);
      else strip.classList.remove('is-dragging');
    };
    window.addEventListener('pointerup', release);
    window.addEventListener('pointercancel', release);
    // a drag must not open the lightbox
    strip.addEventListener(
      'click',
      (e) => {
        if (moved > 6) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true
    );
  }

  function initLightbox() {
    const dialog = document.getElementById('verdi-lightbox') as HTMLDialogElement | null;
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
    if (!dialog || !triggers.length) return;

    const img = document.getElementById('lb-img') as HTMLImageElement | null;
    const title = document.getElementById('lb-title');
    const caption = document.getElementById('lb-caption');
    const counter = document.getElementById('lb-counter');
    const closeBtn = document.getElementById('lb-close');
    const prevBtn = document.getElementById('lb-prev');
    const nextBtn = document.getElementById('lb-next');

    let current = 0;

    const showIndex = (idx: number) => {
      current = (idx + triggers.length) % triggers.length;
      const t = triggers[current];
      if (img) {
        img.src = t.dataset.src || '';
        img.alt = t.dataset.alt || '';
      }
      if (title) title.textContent = t.dataset.title || '';
      if (caption) caption.textContent = t.dataset.caption || '';
      if (counter) counter.textContent = `Foto ${current + 1} von ${triggers.length}`;
    };

    triggers.forEach((btn, idx) => {
      btn.onclick = () => {
        showIndex(idx);
        dialog.showModal();
      };
    });

    if (closeBtn) closeBtn.onclick = () => dialog.close();
    if (prevBtn) prevBtn.onclick = () => showIndex(current - 1);
    if (nextBtn) nextBtn.onclick = () => showIndex(current + 1);

    dialog.onclick = (e) => {
      if (e.target === dialog) dialog.close();
    };

    dialog.onkeydown = (e) => {
      if (e.key === 'ArrowLeft') showIndex(current - 1);
      if (e.key === 'ArrowRight') showIndex(current + 1);
    };
  }

  document.addEventListener('astro:page-load', () => {
    initStrip();
    initLightbox();
  });
</script>
