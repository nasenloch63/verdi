---
import { Picture, getImage } from 'astro:assets';
import photoRucola from '../assets/photos/hero-pizza-rucola.jpg';
import photoSteinofen from '../assets/photos/pizza-steinofen-nah.jpg';
import photoCarbonara from '../assets/photos/spaghetti-carbonara.jpg';
import photoAlForno from '../assets/photos/pasta-al-forno.jpg';
import photoMelanzane from '../assets/photos/melanzane-parmigiana.jpg';
import photoSalatPizza from '../assets/photos/salat-und-pizza.jpg';
import photoPrimavera from '../assets/photos/insalata-primavera.jpg';
import photoMaccheroni from '../assets/photos/maccheroni-sauce.jpg';
import photoAuswahl from '../assets/photos/pizzen-auswahl.jpg';
import photoGastraum from '../assets/photos/gastraum-verdi.jpg';

const rawItems = [
  {
    src: photoSteinofen,
    title: 'Steinofen-Pizza frisch gebacken',
    caption: 'Dünner Teig, knusprig gebräunter Rand und reichhaltiger Belag.',
    alt: 'Nahaufnahme einer frisch gebackenen Steinofen-Pizza aus dem Ristorante Verdi',
    span: 'md:col-span-2 md:row-span-2',
    aspect: 'aspect-[4/3] md:h-full',
    pos: 'object-[50%_75%]',
  },
  {
    src: photoCarbonara,
    title: 'Spaghetti Carbonara',
    caption: 'Gäste-Favorit mit Speck, Zwiebeln, Ei und frisch gehobeltem Parmesan.',
    alt: 'Spaghetti Carbonara mit Parmesanspänen und Speck im Ristorante Verdi',
    span: 'md:col-span-1',
    aspect: 'aspect-[4/4.2]',
    pos: 'object-center',
  },
  {
    src: photoAlForno,
    title: 'Pasta al Forno',
    caption: 'Mit Käse goldbraun im Steinofen überbacken – alle Gerichte 8,50 €.',
    alt: 'Goldbraun mit Käse überbackene Pasta al Forno in der Auflaufform',
    span: 'md:col-span-1',
    aspect: 'aspect-[4/4.2]',
    pos: 'object-center',
  },
  {
    src: photoSalatPizza,
    title: 'Frischer Salat & Steinofen-Pizza',
    caption: 'Knackige Salate der Saison und Pizza für einen entspannten Abend.',
    alt: 'Reichhaltiger Salat mit Champignons und Pizza im Hintergrund am Tisch',
    span: 'md:col-span-2',
    aspect: 'aspect-[16/10]',
    pos: 'object-center',
  },
  {
    src: photoMelanzane,
    title: 'Melanzane alla Parmiggiana',
    caption: 'Überbackene Auberginen in fruchtiger Tomatensauce mit Mozzarella.',
    alt: 'Melanzane alla Parmiggiana – überbackene Auberginen in Tomatensauce',
    span: 'md:col-span-1',
    aspect: 'aspect-[4/3]',
    pos: 'object-center',
  },
  {
    src: photoPrimavera,
    title: 'Insalata Primavera',
    caption: 'Salat der Saison mit Rucola, Krabben, Champignons und warmem Brot.',
    alt: 'Insalata Primavera mit Krabben und frischem Salat',
    span: 'md:col-span-1',
    aspect: 'aspect-[4/3]',
    pos: 'object-center',
  },
  {
    src: photoMaccheroni,
    title: 'Maccheroni frisch aus der Pfanne',
    caption: 'Klassische italienische Pasta in aromatischer Sauce.',
    alt: 'Maccheroni Pasta in cremiger Tomaten-Champignonsauce auf weißem Teller',
    span: 'md:col-span-1',
    aspect: 'aspect-[4/3]',
    pos: 'object-center',
  },
  {
    src: photoAuswahl,
    title: 'Pizzen zum Teilen',
    caption: 'Große 32-cm-Pizzen für den gemütlichen Abend mit Freunden.',
    alt: 'Zwei frisch gebackene Steinofen-Pizzen auf dem Tisch',
    span: 'md:col-span-1',
    aspect: 'aspect-[4/3]',
    pos: 'object-center',
  },
  {
    src: photoRucola,
    title: 'Pizza mit frischem Rucola & Oliven',
    caption: 'Leuchtend rote Tomatensauce, knackiger Rucola und schwarze Oliven.',
    alt: 'Steinofen-Pizza belegt mit frischem Rucola und schwarzen Oliven',
    span: 'md:col-span-2',
    aspect: 'aspect-[16/9]',
    pos: 'object-[50%_72%]',
  },
  {
    src: photoGastraum,
    title: 'Unser Gastraum in Hessisch Lichtenau',
    caption: 'Ruhig, gemütlich und zwanglos – direkt an der Desseler Straße 15.',
    alt: 'Blick in den gemütlichen Gastraum des Ristorante Verdi in Hessisch Lichtenau',
    span: 'md:col-span-2',
    aspect: 'aspect-[16/9]',
    pos: 'object-left',
  },
];

// Pre-generate high-res optimized WebP URLs for the lightbox
const galleryItems = await Promise.all(
  rawItems.map(async (item, idx) => {
    const full = await getImage({ src: item.src, width: 1440, format: 'webp', quality: 84 });
    return { ...item, index: idx, lightboxSrc: full.src };
  })
);
---

<section id="galerie" class="scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-tomato">
          Eindrücke aus Küche &amp; Gastraum
        </p>
        <h2 class="mt-2 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Appetit auf <span class="italic font-normal text-verdi">Verdi?</span>
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted">
        Echte Aufnahmen unserer Steinofen-Pizzen, Pasta-Gerichte, Salate und unseres
        Gastraums. Klicken Sie auf ein Foto für die Großansicht.
      </p>
    </div>

    <!-- Bento / Masonry Photo Grid -->
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
      {galleryItems.map((item) => (
        <figure class={`reveal group relative overflow-hidden rounded-3xl border border-sand bg-parchment ${item.span}`}>
          <button
            type="button"
            data-lightbox-trigger={item.index}
            data-src={item.lightboxSrc}
            data-title={item.title}
            data-caption={item.caption}
            data-alt={item.alt}
            class="block h-full w-full text-left focus-visible:outline-tomato"
            aria-label={`${item.title} vergrößern`}
          >
            <Picture
              src={item.src}
              formats={['avif', 'webp']}
              widths={[480, 840]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 28vw"
              alt={item.alt}
              loading="lazy"
              class={`w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] ${item.aspect} ${item.pos}`}
            />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/80 via-ink/30 to-transparent p-4 pt-12 opacity-95 transition-opacity sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-visible:opacity-100">
              <p class="font-display text-base font-semibold text-cream">{item.title}</p>
              <p class="mt-0.5 text-xs text-cream/80 line-clamp-2">{item.caption}</p>
            </div>
          </button>
        </figure>
      ))}
    </div>
  </div>

  <!-- Native Accessible Lightbox Dialog -->
  <dialog
    id="verdi-lightbox"
    aria-label="Bildergalerie Großansicht"
    class="m-auto max-h-[92vh] w-[94vw] max-w-4xl overflow-hidden rounded-3xl border border-cream/15 bg-ink p-0 text-cream shadow-2xl backdrop:bg-ink/85 backdrop:backdrop-blur-xs"
  >
    <div class="relative flex flex-col">
      <div class="flex items-center justify-between border-b border-cream/10 px-5 py-3.5">
        <div>
          <p id="lb-title" class="font-display text-lg font-semibold text-cream"></p>
          <p id="lb-counter" class="text-xs text-cream/65"></p>
        </div>
        <button
          type="button"
          id="lb-close"
          aria-label="Großansicht schließen"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-cream/20 text-cream transition-colors hover:bg-cream/10"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="relative flex items-center justify-center bg-black/40 p-2 sm:p-4">
        <button
          type="button"
          id="lb-prev"
          aria-label="Vorheriges Foto"
          class="absolute left-3 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-ink/80 text-cream ring-1 ring-cream/20 transition-colors hover:bg-tomato"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>

        <img
          id="lb-img"
          src=""
          alt=""
          class="max-h-[68vh] w-auto rounded-xl object-contain"
        />

        <button
          type="button"
          id="lb-next"
          aria-label="Nächstes Foto"
          class="absolute right-3 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-ink/80 text-cream ring-1 ring-cream/20 transition-colors hover:bg-tomato"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>

      <p id="lb-caption" class="px-5 py-3.5 text-center text-sm text-cream/80"></p>
    </div>
  </dialog>
</section>

<script>
  function initLightbox() {
    const dialog = document.getElementById('verdi-lightbox') as HTMLDialogElement | null;
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
    if (!dialog || !triggers.length) return;

    const img = document.getElementById('lb-img') as HTMLImageElement | null;
    const title = document.getElementById('lb-title');
    const caption = document.getElementById('lb-caption');
    const counter = document.getElementById('lb-counter');
    const closeBtn = document.getElementById('lb-close');
    const prevBtn = document.getElementById('lb-prev');
    const nextBtn = document.getElementById('lb-next');

    let current = 0;

    const showIndex = (idx: number) => {
      current = (idx + triggers.length) % triggers.length;
      const t = triggers[current];
      if (img) {
        img.src = t.dataset.src || '';
        img.alt = t.dataset.alt || '';
      }
      if (title) title.textContent = t.dataset.title || '';
      if (caption) caption.textContent = t.dataset.caption || '';
      if (counter) counter.textContent = `Foto ${current + 1} von ${triggers.length}`;
    };

    triggers.forEach((btn, idx) => {
      btn.onclick = () => {
        showIndex(idx);
        dialog.showModal();
      };
    });

    if (closeBtn) closeBtn.onclick = () => dialog.close();
    if (prevBtn) prevBtn.onclick = () => showIndex(current - 1);
    if (nextBtn) nextBtn.onclick = () => showIndex(current + 1);

    dialog.onclick = (e) => {
      if (e.target === dialog) dialog.close();
    };

    dialog.onkeydown = (e) => {
      if (e.key === 'ArrowLeft') showIndex(current - 1);
      if (e.key === 'ArrowRight') showIndex(current + 1);
    };
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
