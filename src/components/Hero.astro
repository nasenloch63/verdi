---
import { Picture } from 'astro:assets';
import heroCrustWide from '../assets/photos/pizza-steinofen-nah.jpg';
import rucolaDetail from '../assets/photos/hero-pizza-rucola.jpg';
import Icon from './Icon.astro';
import { RESTAURANT } from '../data/restaurant';

const bandWords = [
  { text: 'Steinofen-Pizza', icon: 'pizza' },
  { text: 'Pasta al Forno', icon: 'forno' },
  { text: 'Spaghetti Carbonara', icon: 'pasta' },
  { text: 'Insalata Primavera', icon: 'leaf' },
  { text: 'Melanzane alla Parmiggiana', icon: 'basil' },
  { text: 'Buon appetito', icon: 'heart' },
] as const;
---

<section class="relative overflow-hidden bg-espresso text-cream">
  <div class="relative flex min-h-[84svh] w-full items-end sm:min-h-[88svh] lg:items-center">
    <!-- Full-bleed photo of a real Verdi pizza: slow zoom-out on load, parallax on scroll -->
    <div class="absolute inset-0 overflow-hidden">
      <div data-parallax="40" class="h-[114%] w-full -translate-y-[7%]">
        <div data-hero-image class="h-full w-full">
          <Picture
            src={heroCrustWide}
            formats={['avif', 'webp']}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            alt="Frisch gebackene Steinofen-Pizza aus dem Ristorante Verdi mit kross gebräuntem Rand und reichhaltigem Belag"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover object-[50%_70%]"
          />
        </div>
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#170E09]/90 via-[#1B100A]/55 to-transparent"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#170E09]/80 via-transparent to-[#170E09]/25"></div>
    </div>

    <div class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-14 pt-12 sm:px-6 sm:pb-20 sm:pt-16 lg:px-8 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8 xl:col-span-7">
          <!-- Plain status line: no capsules, just what a guest needs to know -->
          <p data-hero-fade class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.95rem] font-medium text-cream">
            <span data-live-status class="inline-flex items-center gap-2.5">
              <span data-status-dot class="h-2.5 w-2.5 rounded-full bg-status-open"></span>
              <span data-status-text>Mo, Mi–So · 11:00–14:30 &amp; 17:00–21:30</span>
            </span>
            <a href="#bewertungen" class="inline-flex items-center gap-2 text-cream transition-colors hover:text-brass-light">
              <span class="inline-flex gap-0.5 text-brass-light" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
              </span>
              <span>
                <strong class="font-bold">{RESTAURANT.rating.scoreDisplay}</strong> bei Google ·{' '}
                <span class="link-draw">{RESTAURANT.rating.count} Bewertungen</span>
              </span>
            </a>
          </p>

          <p data-hero-fade class="kicker kicker-light mb-2">{RESTAURANT.tagline}</p>

          <h1
            data-split-hero
            class="font-display text-[3.05rem] font-medium leading-[0.98] tracking-[-0.03em] text-cream drop-shadow-[0_2px_18px_rgba(14,8,4,0.5)] sm:text-[4.4rem] lg:text-[5.6rem]"
          >
            Die Steinofenpizza<br />
            aus{' '}
            <span class="relative inline-block italic font-normal text-parchment">
              Heli.
              <svg
                class="pointer-events-none absolute -bottom-[0.14em] left-0 h-[0.26em] w-full text-tomato"
                viewBox="0 0 200 22"
                preserveAspectRatio="none"
                fill="none"
                aria-hidden="true"
              >
                <path data-draw d="M4 14C40 5 92 4 196 9M22 19c44-5 96-6 150-3" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" pathLength="1" />
              </svg>
            </span>
          </h1>

          <p data-hero-fade class="mt-7 max-w-xl text-lg leading-relaxed text-cream/95 sm:text-xl">
            Hauchdünner Teig aus dem heißen Steinofen, frische Zutaten und ehrliche Portionen.
            Schnell zum Mitnehmen oder gemütlich bei uns an der{' '}
            <span class="font-semibold text-cream">{RESTAURANT.street}</span>.
          </p>

          <div data-hero-fade class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
            <a href={RESTAURANT.phoneHref} data-magnetic class="btn btn-primary text-[1.05rem]">
              <Icon name="phone" size={20} />
              <span>Jetzt anrufen · {RESTAURANT.phoneDisplay}</span>
            </a>
            <a href="#speisekarte" data-magnetic class="btn btn-line-light">
              <Icon name="book" size={20} />
              <span>Speisekarte ansehen</span>
            </a>
          </div>

          <!-- Three facts, in plain words with a fitting icon each -->
          <ul data-hero-fade class="mt-10 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-4 text-cream [--ic-accent:#e0553d] sm:grid-cols-3">
            <li class="flex items-center gap-3">
              <Icon name="pizza" size={34} class="text-brass-light" />
              <span class="leading-tight">
                <span class="block font-display text-[1.15rem] font-medium">Ø 32 cm ab 7&nbsp;€</span>
                <span class="text-sm text-parchment/85">Steinofen-Pizza</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="bag" size={34} class="text-brass-light" />
              <span class="leading-tight">
                <span class="block font-display text-[1.15rem] font-medium">Abholen oder hier essen</span>
                <span class="text-sm text-parchment/85">Kein Lieferdienst</span>
              </span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="clock" size={34} class="text-brass-light" />
              <span class="leading-tight">
                <span class="block font-display text-[1.15rem] font-medium">Dienstag Ruhetag</span>
                <span class="text-sm text-parchment/85">Sonst täglich geöffnet</span>
              </span>
            </li>
          </ul>
        </div>

        <!-- A printed snapshot pinned into the scene, plus the turning house seal -->
        <div class="hidden lg:col-span-4 lg:flex lg:justify-end xl:col-span-5" data-parallax="-22">
          <div data-hero-snap class="relative w-72 xl:w-80">
            <figure class="snapshot" style="--tilt: 4deg">
              <span class="tape" aria-hidden="true"></span>
              <Picture
                src={rucolaDetail}
                formats={['avif', 'webp']}
                widths={[400, 640]}
                sizes="320px"
                alt="Steinofen-Pizza mit frischem Rucola und schwarzen Oliven aus dem Ristorante Verdi"
                loading="eager"
                class="aspect-[4/3.4] w-full object-cover object-[50%_76%]"
              />
              <figcaption class="font-hand px-1 pb-1 pt-2.5 text-center text-[1.55rem] leading-none text-walnut">
                24 Sorten, frisch aus dem Ofen
              </figcaption>
            </figure>

            <div class="absolute -left-20 -top-12 h-32 w-32 drop-shadow-[0_10px_14px_rgba(10,5,2,0.5)]" aria-hidden="true">
              <svg viewBox="0 0 140 140" class="seal-spin h-full w-full">
                <defs>
                  <path id="hero-seal-arc" d="M70 70m-52 0a52 52 0 1 1 104 0a52 52 0 1 1-104 0" />
                </defs>
                <circle cx="70" cy="70" r="68" fill="#A93320" />
                <circle cx="70" cy="70" r="63" fill="none" stroke="#F6EFE6" stroke-width="1" stroke-dasharray="2 3" opacity="0.7" />
                <text fill="#F6EFE6" font-family="'Figtree Variable', sans-serif" font-size="11.5" font-weight="700" letter-spacing="2.6">
                  <textPath href="#hero-seal-arc" startOffset="0">FRISCH AUS DEM STEINOFEN ✦ RISTORANTE VERDI ✦</textPath>
                </text>
              </svg>
              <span class="absolute inset-0 flex items-center justify-center text-cream [--ic-accent:#F2C36B]">
                <Icon name="oven" size={46} />
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Running band of the house classics: speeds up and leans with the scroll -->
  <div class="wood-dark-bar overflow-hidden border-y border-brass/40 py-4 sm:py-5" aria-hidden="true">
    <div data-band data-speed="42" class="band items-center [--ic-accent:#e0553d]">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {bandWords.map((w) => (
            <span class="flex items-center gap-6 pr-6 sm:gap-9 sm:pr-9">
              <span class="whitespace-nowrap font-display text-[1.7rem] italic text-cream sm:text-[2.5rem]">{w.text}</span>
              <Icon name={w.icon} size={30} class="text-brass-light" />
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
