---
import { Picture } from 'astro:assets';
import heroPizza from '../assets/photos/hero-pizza-rucola.jpg';
import crustDetail from '../assets/photos/pizza-steinofen-nah.jpg';
import { RESTAURANT } from '../data/restaurant';
---

<section class="relative overflow-hidden border-b border-sand/80">
  <!-- Subtle ambient warm wash -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 right-0 h-[34rem] w-[34rem] rounded-full bg-tomato/[0.06] blur-3xl"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-24 -left-16 h-[28rem] w-[28rem] rounded-full bg-verdi/[0.06] blur-3xl"
  ></div>

  <div class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 sm:pb-24 sm:pt-12 lg:px-8 lg:pb-28 lg:pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Editorial Copy Column -->
      <div class="lg:col-span-6 xl:col-span-6">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span
            data-live-status
            class="inline-flex items-center gap-2 rounded-full border border-verdi/25 bg-verdi-soft px-3.5 py-1.5 text-xs font-semibold tracking-wide text-verdi"
          >
            <span data-status-dot class="h-2 w-2 rounded-full bg-verdi"></span>
            <span data-status-text>Mo, Mi–So · 11:00–14:30 &amp; 17:00–21:30</span>
          </span>

          <a
            href="#bewertungen"
            class="inline-flex items-center gap-1.5 rounded-full border border-sand bg-parchment/90 px-3.5 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-crust/60"
          >
            <svg class="h-3.5 w-3.5 text-crust" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
            <span>{RESTAURANT.rating.scoreDisplay} ★</span>
            <span class="text-muted">({RESTAURANT.rating.count} Google-Bewertungen)</span>
          </a>
        </div>

        <p class="mb-3 font-display text-sm italic tracking-wide text-tomato sm:text-base">
          „{RESTAURANT.tagline}“ · {RESTAURANT.city}
        </p>

        <h1 class="font-display text-[2.65rem] font-semibold leading-[1.03] tracking-[-0.03em] text-ink sm:text-6xl xl:text-[4.25rem]">
          Steinofen-Pizza aus{' '}
          <span class="italic font-normal text-verdi">Hessisch Lichtenau.</span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
          Hauchdünner Teig aus dem heißen Steinofen, frische Zutaten und ehrliche Portionen –
          seit Jahren beliebt für blitzschnelle Abholung oder einen entspannten Abend an der
          <span class="font-medium text-ink">{RESTAURANT.street}</span>.
        </p>

        <!-- Hand-drawn musical cadence flourish (Verdi nod) -->
        <svg
          class="mt-6 h-4 w-44 text-tomato/65"
          viewBox="0 0 180 18"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M2 12 C 28 2, 52 17, 82 9 C 110 2, 140 16, 178 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
          <path
            d="M20 15 C 58 9, 108 15, 162 11"
            stroke="#1F4D36"
            stroke-width="1"
            stroke-linecap="round"
            opacity="0.55"
          />
        </svg>

        <!-- Primary & Secondary CTAs -->
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={RESTAURANT.phoneHref}
            class="group inline-flex items-center justify-center gap-3 rounded-full bg-tomato px-7 py-4 text-base font-semibold text-cream shadow-md shadow-tomato/20 transition-all hover:bg-tomato-dark hover:shadow-lg hover:shadow-tomato/25 active:scale-[0.98]"
          >
            <svg class="h-5 w-5 transition-transform group-hover:-rotate-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Jetzt anrufen · {RESTAURANT.phoneDisplay}</span>
          </a>

          <a
            href="#speisekarte"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-verdi/30 bg-transparent px-7 py-3.5 text-base font-semibold text-verdi transition-all hover:border-verdi hover:bg-verdi hover:text-cream"
          >
            <span>Speisekarte ansehen</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M19 12l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Micro facts bar -->
        <dl class="mt-9 grid grid-cols-3 gap-4 border-t border-sand pt-6 text-sm">
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted">Steinofen-Pizza</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink">Ø 32 cm ab 7 €</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted">Abholung &amp; Vor Ort</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink">Kein Lieferdienst</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-muted">Ruhetag</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink">Dienstags</dd>
          </div>
        </dl>
      </div>

      <!-- Art-Directed Photography Column -->
      <div class="relative lg:col-span-6 xl:col-span-6">
        <div class="relative mx-auto max-w-xl lg:max-w-none">
          <!-- Main Pizza Frame -->
          <div class="relative overflow-hidden rounded-[2rem] border border-sand bg-parchment shadow-2xl shadow-ink/10">
            <Picture
              src={heroPizza}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 100vw, 48vw"
              alt="Frisch gebackene Steinofen-Pizza aus dem Ristorante Verdi mit leuchtend roter Tomatensauce, frischem Rucola und schwarzen Oliven"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/3.35] w-full object-cover object-[50%_72%] transition-transform duration-700 hover:scale-[1.03]"
            />
            <!-- Warm bottom vignette for caption legibility -->
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink/70 via-ink/25 to-transparent"></div>
            <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between text-cream">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-cream/80">
                  Frischegarantie
                </p>
                <p class="font-display text-lg italic leading-snug">
                  Knusprig aus dem Steinofen
                </p>
              </div>
              <span class="rounded-full bg-cream/95 px-3 py-1 text-xs font-bold text-verdi shadow-sm">
                24 Sorten · Ø 32 cm
              </span>
            </div>
          </div>

          <!-- Floating Secondary Stone-Oven Detail Card (Desktop / Tablet) -->
          <div class="absolute -bottom-7 -left-5 hidden w-44 overflow-hidden rounded-2xl border-4 border-cream bg-parchment shadow-xl sm:block lg:-left-8 lg:w-52">
            <Picture
              src={crustDetail}
              formats={['avif', 'webp']}
              widths={[320, 480]}
              sizes="210px"
              alt="Detailaufnahme einer kross gebackenen Steinofen-Pizza mit goldbraunem Rand"
              loading="eager"
              class="aspect-[4/3] w-full object-cover object-[50%_75%]"
            />
            <div class="bg-verdi-dark px-3 py-2 text-center text-[0.7rem] font-medium tracking-wide text-cream">
              Original Verdi Steinofen
            </div>
          </div>

          <!-- Floating Stamp Badge -->
          <div
            class="absolute -right-2 -top-4 flex h-22 w-22 rotate-6 flex-col items-center justify-center rounded-full border-2 border-dashed border-cream/60 bg-verdi text-center text-cream shadow-lg sm:-right-4 sm:-top-5 sm:h-24 sm:w-24"
          >
            <span class="font-display text-2xl font-bold leading-none">{RESTAURANT.rating.scoreDisplay}★</span>
            <span class="mt-0.5 text-[0.65rem] font-semibold uppercase tracking-wider text-cream/85">
              216 Gäste
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
