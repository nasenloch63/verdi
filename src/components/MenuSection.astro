---
import { Picture, getImage } from 'astro:assets';
import menuData from '../data/menu.json';
import { RESTAURANT } from '../data/restaurant';
import Icon from './Icon.astro';
import VerdiEmblem from './VerdiEmblem.astro';
import photoPizza from '../assets/photos/pizzen-holztisch.jpg';
import photoMini from '../assets/photos/pizzen-auswahl.jpg';
import photoPasta from '../assets/photos/spaghetti-carbonara.jpg';
import photoForno from '../assets/photos/pasta-al-forno.jpg';
import photoSalat from '../assets/photos/insalata-primavera.jpg';
import photoMelanzane from '../assets/photos/melanzane-parmigiana.jpg';

const formatPrice = (p: number) => p.toFixed(2).replace('.', ',') + ' €';
const totalItems = menuData.categories.reduce((acc, c) => acc + c.items.length, 0);
const count = (id: string) => menuData.categories.find((c) => c.id === id)?.items.length ?? 0;

// Short everyday words + a fitting icon for every chapter of the menu
const chapterMeta: Record<string, { label: string; sub: string; icon: any; photo: ImageMetadata; alt: string; tilt: string }> = {
  pizza: {
    label: 'Pizza',
    sub: `${count('pizza')} × Ø 32 cm`,
    icon: 'pizza',
    photo: photoPizza,
    alt: 'Frisch gebackene Steinofen-Pizzen auf dem Holztisch',
    tilt: '3deg',
  },
  'mini-pizza': {
    label: 'Mini-Pizza',
    sub: `${count('mini-pizza')} × Ø 24 cm`,
    icon: 'pizza-mini',
    photo: photoMini,
    alt: 'Zwei Steinofen-Pizzen aus dem Ristorante Verdi',
    tilt: '-3deg',
  },
  pasta: {
    label: 'Pasta',
    sub: `${count('pasta')} Gerichte`,
    icon: 'pasta',
    photo: photoPasta,
    alt: 'Spaghetti Carbonara mit Parmesanspänen',
    tilt: '2.5deg',
  },
  'pasta-al-forno': {
    label: 'Al Forno',
    sub: `${count('pasta-al-forno')} × überbacken`,
    icon: 'forno',
    photo: photoForno,
    alt: 'Goldbraun überbackene Pasta al Forno',
    tilt: '-2.5deg',
  },
  'salate-vorspeisen': {
    label: 'Salate',
    sub: `${count('salate-vorspeisen')} × knackig`,
    icon: 'leaf',
    photo: photoSalat,
    alt: 'Insalata Primavera mit Krabben und frischem Salat',
    tilt: '3deg',
  },
};

// A few dishes have their own photo: it follows the pointer while hovering the row (desktop)
const previewSources: Record<string, ImageMetadata> = { '64': photoPasta, '41': photoSalat, '44': photoMelanzane };
const previews: Record<string, string> = {};
for (const [num, src] of Object.entries(previewSources)) {
  previews[num] = (await getImage({ src, width: 520, format: 'webp', quality: 80 })).src;
}
---

<section id="speisekarte" class="bg-surface-beige relative scroll-mt-20 pb-18 pt-14 sm:pb-26 sm:pt-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-col gap-2 sm:mb-9 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="kicker">Worauf haben Sie Lust?</p>
        <h2 data-split class="mt-1 font-display text-4xl font-medium tracking-tight text-ink sm:text-[3.4rem] sm:leading-[1.02]">
          Unsere <span class="italic font-normal text-wood-warm">Speisekarte</span>
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-3 pb-1">
        <button type="button" id="veggie-toggle" aria-pressed="false" class="veg-switch veg-switch-ink">
          <span class="veg-track" aria-hidden="true"><span class="veg-thumb"></span></span>
          <span>Nur vegetarisch</span>
        </button>
        <div class="relative w-full sm:w-64">
          <label for="menu-search" class="sr-only">Gericht oder Zutat suchen</label>
          <Icon name="search" size={17} class="pointer-events-none absolute left-0 top-1/2 -translate-y-1/2 text-wood-warm" />
          <input
            id="menu-search"
            type="search"
            placeholder="Zutat suchen, z. B. Rucola"
            autocomplete="off"
            class="w-full border-b-[1.5px] border-walnut/40 bg-transparent py-1.5 pl-7 pr-1 text-base text-ink placeholder:text-muted/80 focus:border-tomato focus:outline-none"
          />
        </div>
      </div>
    </div>

    <!-- Sticky category bar: an icon and one plain word per rubric -->
    <div class="wood-dark-bar sticky top-[70px] z-30 mb-8 rounded-xl border border-brass/35 px-2 py-2 shadow-[0_14px_34px_-12px_rgba(19,11,7,0.5)] sm:px-3">
      <div>
        <div
          role="tablist"
          aria-label="Rubriken der Speisekarte"
          class="menu-tabs no-scrollbar flex min-w-0 snap-x items-stretch gap-0.5 overflow-x-auto lg:justify-between"
        >
          <button type="button" role="tab" aria-selected="true" data-cat-btn="all" class="menu-tab">
            <Icon name="book" size={28} />
            <span>
              <span class="menu-tab-label block">Alles</span>
              <span class="menu-tab-sub block">{totalItems} Gerichte</span>
            </span>
          </button>
          {menuData.categories.map((cat) => (
            <button type="button" role="tab" aria-selected="false" data-cat-btn={cat.id} class="menu-tab">
              <Icon name={chapterMeta[cat.id].icon} size={28} />
              <span>
                <span class="menu-tab-label block">{chapterMeta[cat.id].label}</span>
                <span class="menu-tab-sub block">{chapterMeta[cat.id].sub}</span>
              </span>
            </button>
          ))}
          <button type="button" role="tab" aria-selected="false" data-cat-btn="extras" class="menu-tab">
            <Icon name="plus" size={28} />
            <span>
              <span class="menu-tab-label block">Extras</span>
              <span class="menu-tab-sub block">Beläge</span>
            </span>
          </button>
        </div>

      </div>
    </div>

    <!-- Walnut frame holding the printed menu card -->
    <div class="wood-dark-frame relative rounded-xl p-2.5 sm:rounded-2xl sm:p-5 md:p-7">
      <div class="menu-sheet relative overflow-hidden rounded-[4px] p-2.5 sm:p-4 md:p-6">
        <div class="tricolore absolute inset-x-0 top-0 h-1.5" aria-hidden="true"></div>

        <div class="relative border border-brass/60 px-4 py-9 sm:px-9 sm:py-13 md:px-14 md:py-16">
          <span aria-hidden="true" class="pointer-events-none absolute -left-[5px] -top-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>
          <span aria-hidden="true" class="pointer-events-none absolute -right-[5px] -top-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>
          <span aria-hidden="true" class="pointer-events-none absolute -bottom-[5px] -left-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>
          <span aria-hidden="true" class="pointer-events-none absolute -bottom-[5px] -right-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>

          <!-- Masthead built around the house emblem -->
          <header class="reveal mx-auto max-w-2xl text-center">
            <VerdiEmblem uid="menu-emblem" class="mx-auto w-60 sm:w-80" />
            <p class="font-hand mt-4 text-[1.9rem] leading-none text-tomato sm:text-[2.3rem]">
              {RESTAURANT.tagline}
            </p>
            <p class="mx-auto mt-5 flex max-w-lg items-start justify-center gap-2.5 text-left text-[0.98rem] leading-relaxed text-muted sm:items-center sm:text-center">
              <Icon name="basil" size={26} class="mt-0.5 shrink-0 text-verdi [--ic-accent:#4a8a55] sm:mt-0" />
              <span>
                {menuData.freshnessNote} Vorbestellen zur Abholung:{' '}
                <a href={RESTAURANT.phoneHref} class="link-draw whitespace-nowrap font-bold text-ink hover:text-tomato">
                  {RESTAURANT.phoneDisplay}
                </a>
              </span>
            </p>
            <svg class="mx-auto mt-7 h-5 w-44 text-brass" viewBox="0 0 180 20" fill="none" aria-hidden="true">
              <path d="M4 10c18-9 34 9 52 0s34-9 52 0 34 9 68 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <circle cx="90" cy="10" r="3" fill="#A93320" />
            </svg>
          </header>

          <div
            id="menu-empty-state"
            hidden
            class="my-12 rounded-lg border border-dashed border-taupe bg-parchment/55 px-6 py-12 text-center"
          >
            <p class="font-display text-2xl italic text-ink">Dazu haben wir leider nichts gefunden.</p>
            <p class="mt-2 text-base text-muted">Versuchen Sie eine andere Zutat oder zeigen Sie wieder alles an.</p>
            <button type="button" id="menu-reset-btn" class="btn btn-sm btn-line-dark mt-5">
              Ganze Speisekarte zeigen
            </button>
          </div>

          <div class="mt-14 space-y-16 sm:space-y-20" id="menu-sections-wrapper">
            {menuData.categories.map((cat) => {
              const meta = chapterMeta[cat.id];
              return (
                <section data-menu-category={cat.id} aria-labelledby={`cat-heading-${cat.id}`}>
                  <div class="mb-7 flex items-end justify-between gap-6 sm:mb-9">
                    <div class="flex items-center gap-4 sm:gap-5">
                      <span class="medallion h-16 w-16 sm:h-[5.2rem] sm:w-[5.2rem]">
                        <Icon name={meta.icon} size={40} class="sm:scale-[1.18]" />
                      </span>
                      <div>
                        <h3
                          id={`cat-heading-${cat.id}`}
                          class="font-display text-[1.75rem] font-medium leading-[1.05] tracking-tight text-walnut sm:text-[2.5rem]"
                        >
                          {cat.title}
                        </h3>
                        <p class="mt-1.5 text-[0.95rem] leading-snug text-muted sm:text-base">{cat.subtitle}</p>
                      </div>
                    </div>

                    <figure
                      data-snap-in
                      class="snapshot -mb-1 hidden w-40 shrink-0 md:block lg:w-48"
                      style={`--tilt: ${meta.tilt}`}
                    >
                      <span class="tape" aria-hidden="true"></span>
                      <Picture
                        src={meta.photo}
                        formats={['avif', 'webp']}
                        widths={[240, 420]}
                        sizes="200px"
                        alt={meta.alt}
                        loading="lazy"
                        class="aspect-[4/3] w-full object-cover"
                      />
                    </figure>
                  </div>

                  <!-- On phones the dish photo runs as a band above the list -->
                  <div class="mb-6 overflow-hidden rounded-md border-[5px] border-[#fbf7f0] shadow-[0_14px_26px_-16px_rgba(20,11,6,0.6)] md:hidden">
                    <Picture
                      src={meta.photo}
                      formats={['avif', 'webp']}
                      widths={[480, 760]}
                      sizes="92vw"
                      alt=""
                      loading="lazy"
                      class="aspect-[16/7] w-full object-cover"
                    />
                  </div>

                  <ul class="relative grid gap-x-12 gap-y-5 md:grid-cols-2">
                    {cat.items.map((item) => (
                      <li
                        data-menu-item
                        data-veg={item.vegetarian ? 'true' : 'false'}
                        data-search={`${item.number} ${item.name} ${item.description}`.toLowerCase()}
                        data-preview={previews[item.number]}
                        class="group border-b border-sand/75 pb-3.5 transition-colors hover:border-brass"
                      >
                        <div class="flex items-baseline gap-2">
                          <span class="w-7 shrink-0 text-[0.85rem] font-semibold tabular-nums text-wood-warm/80">
                            {item.number}
                          </span>

                          <h4 class="font-display text-[1.2rem] font-medium leading-snug text-ink transition-colors group-hover:text-tomato">
                            {item.name}
                          </h4>

                          {item.vegetarian && (
                            <span title="Vegetarisch" class="inline-flex shrink-0 translate-y-0.5 text-verdi [--ic-accent:#4a8a55]">
                              <Icon name="leaf" size={17} title="Vegetarisch" />
                            </span>
                          )}

                          <span class="menu-leader mx-1.5 mb-1.5 hidden h-[2px] min-w-[16px] flex-1 self-end sm:block" aria-hidden="true"></span>

                          <span class="ml-auto shrink-0 font-display text-[1.2rem] font-semibold tabular-nums text-ink">
                            {formatPrice(item.price)}
                          </span>
                        </div>

                        <div class="mt-0.5 flex items-baseline justify-between gap-4 pl-9">
                          <p class="text-[0.95rem] leading-relaxed text-muted">
                            {item.description}
                            {item.highlight && (
                              <span class="font-hand ml-2 inline-flex -rotate-2 items-center gap-1 whitespace-nowrap align-baseline text-[1.3rem] leading-none text-tomato">
                                <Icon name="heart" size={15} />
                                {item.highlight}
                              </span>
                            )}
                          </p>
                          {item.allergens && (
                            <span class="shrink-0 text-[0.72rem] text-muted/80" title={`Allergene / Zusatzstoffe: ${item.allergens}`}>
                              {item.allergens}
                            </span>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}

            <!-- Wunschbeläge -->
            <section data-menu-category="extras" aria-labelledby="cat-heading-extras">
              <div class="mb-7 flex items-center gap-4 sm:gap-5">
                <span class="medallion h-16 w-16 sm:h-[5.2rem] sm:w-[5.2rem]">
                  <Icon name="plus" size={40} class="sm:scale-[1.18]" />
                </span>
                <div>
                  <h3 id="cat-heading-extras" class="font-display text-[1.75rem] font-medium leading-[1.05] tracking-tight text-walnut sm:text-[2.5rem]">
                    Wunschbeläge
                  </h3>
                  <p class="mt-1.5 text-[0.95rem] leading-snug text-muted sm:text-base">
                    Jede Pizza lässt sich erweitern. Der Aufpreis gilt je Belag.
                  </p>
                </div>
              </div>

              <div class="grid gap-4 md:grid-cols-3">
                {menuData.extras.map((tier) => (
                  <div class="rounded-md border border-sand bg-[#fbf6ee]/80 px-5 py-5">
                    <p class="font-display text-[1.7rem] font-semibold tabular-nums text-tomato">+ {formatPrice(tier.price)}</p>
                    <p class="mt-2 text-[0.98rem] leading-relaxed text-ink/90">{tier.items}</p>
                  </div>
                ))}
              </div>
            </section>
          </div>

          <footer class="mt-14 border-t border-brass/45 pt-6">
            <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-[0.92rem] text-muted">
              <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
                <span class="inline-flex items-center gap-1.5 text-verdi [--ic-accent:#4a8a55]">
                  <Icon name="leaf" size={17} />
                  <span class="text-muted">vegetarisch</span>
                </span>
                <span class="inline-flex items-center gap-1.5 text-tomato">
                  <Icon name="heart" size={16} />
                  <span class="text-muted">Lieblinge unserer Gäste und des Hauses</span>
                </span>
              </p>
              <p>Alle Preise in Euro inkl. MwSt.</p>
            </div>

            <details class="mt-5 border-t border-sand/85 pt-4 text-muted">
              <summary class="cursor-pointer font-display text-[1.1rem] font-medium text-ink transition-colors hover:text-tomato">
                Allergene (a–n) und Zusatzstoffe (1–13) nachlesen
              </summary>
              <div class="mt-4 grid gap-6 border-t border-sand/75 pt-4 md:grid-cols-2">
                <div>
                  <h4 class="font-display text-lg font-semibold text-walnut">Allergene</h4>
                  <dl class="mt-2 grid grid-cols-1 gap-1 text-sm sm:grid-cols-2">
                    {menuData.allergenLegend.map((a) => (
                      <div>
                        <dt class="inline font-bold text-ink">{a.code} =</dt>{' '}
                        <dd class="inline">{a.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div>
                  <h4 class="font-display text-lg font-semibold text-walnut">Zusatzstoffe</h4>
                  <dl class="mt-2 space-y-1 text-sm">
                    {menuData.additiveLegend.map((z) => (
                      <div>
                        <dt class="inline font-bold text-ink">{z.code} =</dt>{' '}
                        <dd class="inline">{z.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            </details>
          </footer>
        </div>
      </div>
    </div>
  </div>

  <!-- Dish photo that follows the pointer over rows that have one -->
  <div
    id="menu-preview"
    aria-hidden="true"
    class="pointer-events-none fixed left-0 top-0 z-50 hidden w-56 opacity-0 transition-opacity duration-200 lg:block"
  >
    <div class="snapshot" style="--tilt: -4deg">
      <img src="" alt="" class="aspect-[4/3] w-full object-cover" />
    </div>
  </div>
</section>

<script>
  function initMenuFilter() {
    const catButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-btn]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-category]'));
    const wrapper = document.getElementById('menu-sections-wrapper');
    const vegBtn = document.getElementById('veggie-toggle') as HTMLButtonElement | null;
    const searchInput = document.getElementById('menu-search') as HTMLInputElement | null;
    const emptyState = document.getElementById('menu-empty-state');
    const resetBtn = document.getElementById('menu-reset-btn');

    if (!catButtons.length || !sections.length || !wrapper) return;

    let activeCat = 'all';
    let vegOnly = false;
    let query = '';

    const applyFilter = () => {
      let visibleTotal = 0;

      sections.forEach((sec) => {
        const secCat = sec.dataset.menuCategory || '';
        const catMatches = activeCat === 'all' || activeCat === secCat;

        if (!catMatches) {
          sec.hidden = true;
          return;
        }

        if (secCat === 'extras') {
          const textMatches = !query || sec.textContent?.toLowerCase().includes(query);
          sec.hidden = !textMatches || vegOnly;
          if (!sec.hidden) visibleTotal += 1;
          return;
        }

        const items = Array.from(sec.querySelectorAll<HTMLElement>('[data-menu-item]'));
        let secVisible = 0;

        items.forEach((item) => {
          const isVeg = item.dataset.veg === 'true';
          const haystack = item.dataset.search || '';
          const ok = (!vegOnly || isVeg) && (!query || haystack.includes(query));
          item.hidden = !ok;
          if (ok) secVisible += 1;
        });

        sec.hidden = secVisible === 0;
        visibleTotal += secVisible;
      });

      if (emptyState) emptyState.hidden = visibleTotal > 0;

      // replay the soft entrance for whatever is visible now
      wrapper.classList.remove('menu-swap');
      void wrapper.offsetWidth;
      wrapper.classList.add('menu-swap');
      window.dispatchEvent(new Event('verdi:layout'));
    };

    const bringIntoView = () => {
      const top = wrapper.getBoundingClientRect().top;
      if (top > 150 && top < window.innerHeight * 0.7) return;
      const target = window.scrollY + top - 170;
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(target, { duration: 0.9 });
      else window.scrollTo({ top: target, behavior: 'smooth' });
    };

    const setActiveButton = (targetCat: string, scroll = true) => {
      activeCat = targetCat;
      catButtons.forEach((btn) => {
        const selected = btn.dataset.catBtn === activeCat;
        btn.setAttribute('aria-selected', String(selected));
        if (selected) btn.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      });
      applyFilter();
      if (scroll) bringIntoView();
    };

    catButtons.forEach((btn) => {
      btn.onclick = () => setActiveButton(btn.dataset.catBtn || 'all');
    });

    if (vegBtn) {
      vegBtn.onclick = () => {
        vegOnly = !vegOnly;
        vegBtn.setAttribute('aria-pressed', String(vegOnly));
        applyFilter();
      };
    }

    if (searchInput) {
      searchInput.oninput = () => {
        query = searchInput.value.trim().toLowerCase();
        applyFilter();
      };
    }

    if (resetBtn) {
      resetBtn.onclick = () => {
        vegOnly = false;
        query = '';
        if (searchInput) searchInput.value = '';
        if (vegBtn) vegBtn.setAttribute('aria-pressed', 'false');
        setActiveButton('all', false);
      };
    }

    // Pointer-following dish photo (fine pointers only)
    const preview = document.getElementById('menu-preview');
    const previewImg = preview?.querySelector('img');
    if (preview && previewImg && window.matchMedia('(pointer: fine)').matches) {
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let raf = 0;
      const loop = () => {
        x += (tx - x) * 0.16;
        y += (ty - y) * 0.16;
        preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(loop) : 0;
      };
      document.querySelectorAll<HTMLElement>('[data-menu-item][data-preview]').forEach((row) => {
        row.addEventListener('pointerenter', (e) => {
          previewImg.src = row.dataset.preview || '';
          x = tx = e.clientX + 28;
          y = ty = e.clientY - 150;
          preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          preview.style.opacity = '1';
        });
        row.addEventListener('pointermove', (e) => {
          tx = e.clientX + 28;
          ty = e.clientY - 150;
          if (!raf) raf = requestAnimationFrame(loop);
        });
        row.addEventListener('pointerleave', () => {
          preview.style.opacity = '0';
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initMenuFilter);
</script>
