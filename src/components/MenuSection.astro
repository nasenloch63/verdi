---
import menuData from '../data/menu.json';
import { RESTAURANT } from '../data/restaurant';

const formatPrice = (p: number) => p.toFixed(2).replace('.', ',') + ' €';
const totalItems = menuData.categories.reduce((acc, c) => acc + c.items.length, 0);
const vegetarianCount = menuData.categories.reduce(
  (acc, c) => acc + c.items.filter((i) => i.vegetarian).length,
  0
);
const romanNumerals = ['I', 'II', 'III', 'IV', 'V'];
---

<section id="speisekarte" class="bg-surface-beige relative scroll-mt-20 py-18 sm:py-26">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Sticky Dark-Walnut Navigation & Filter Ribbon above the Wood-Framed Menu Sheet -->
    <div class="wood-dark-bar sticky top-[62px] z-30 mb-8 rounded-2xl border border-brass/35 px-3 py-2.5 shadow-[0_14px_34px_-12px_rgba(19,11,7,0.45)] backdrop-blur-md sm:px-4 sm:py-3">
      <div class="flex flex-col gap-2.5 xl:flex-row xl:items-center xl:justify-between xl:gap-3">
        <!-- Classic Book-Tab Category Selector -->
        <div
          role="tablist"
          aria-label="Speisekarten-Kapitel"
          class="no-scrollbar flex min-w-0 items-center gap-1.5 overflow-x-auto pb-0.5 xl:pb-0"
        >
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-cat-btn="all"
            class="cat-pill shrink-0 whitespace-nowrap rounded-full bg-cream px-3 py-1.5 font-display text-[0.84rem] font-bold tracking-wide text-espresso shadow-xs transition-all"
          >
            Alle ({totalItems})
          </button>
          {menuData.categories.map((cat) => (
            <button
              type="button"
              role="tab"
              aria-selected="false"
              data-cat-btn={cat.id}
              class="cat-pill shrink-0 whitespace-nowrap rounded-full border border-brass/30 bg-walnut/65 px-2.5 py-1.5 font-display text-[0.84rem] font-semibold tracking-wide text-cream/90 transition-all hover:border-brass-light/70 hover:text-brass-light"
            >
              {cat.title}
            </button>
          ))}
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-cat-btn="extras"
            class="cat-pill shrink-0 whitespace-nowrap rounded-full border border-brass/30 bg-walnut/65 px-2.5 py-1.5 font-display text-[0.84rem] font-semibold tracking-wide text-cream/90 transition-all hover:border-brass-light/70 hover:text-brass-light"
          >
            Extras
          </button>
        </div>

        <!-- Veggie Filter & Search -->
        <div class="flex shrink-0 items-center gap-2">
          <button
            type="button"
            id="veggie-toggle"
            aria-pressed="false"
            class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-brass/35 bg-espresso/75 px-3 py-1.5 text-xs font-semibold text-cream/90 transition-all hover:border-brass-light hover:text-cream"
          >
            <svg class="h-3.5 w-3.5 text-status-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
            </svg>
            <span>Vegetarisch ({vegetarianCount})</span>
          </button>

          <div class="relative flex-1 sm:w-36 xl:w-36">
            <label for="menu-search" class="sr-only">Gericht oder Zutat suchen</label>
            <svg
              class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-brass-light/80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              id="menu-search"
              type="search"
              placeholder="Zutat suchen…"
              autocomplete="off"
              class="w-full rounded-full border border-brass/35 bg-espresso/80 py-1.5 pl-8 pr-3 text-xs text-cream placeholder:text-sand/70 focus:border-brass-light focus:bg-espresso focus:outline-none"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- DARK SMOKED WALNUT WOOD FRAME CRADLING THE AUTHENTIC ITALIAN SPEISEKARTE -->
    <div class="wood-dark-frame relative rounded-xl p-2.5 sm:rounded-2xl sm:p-5 md:p-7">
      <!-- Subtle Corner Antique Brass Rivet Accents on the Dark Wood Frame -->
      <span aria-hidden="true" class="pointer-events-none absolute left-2 top-2 hidden h-2 w-2 rounded-full border border-brass-light/60 bg-brass/40 sm:block"></span>
      <span aria-hidden="true" class="pointer-events-none absolute right-2 top-2 hidden h-2 w-2 rounded-full border border-brass-light/60 bg-brass/40 sm:block"></span>
      <span aria-hidden="true" class="pointer-events-none absolute bottom-2 left-2 hidden h-2 w-2 rounded-full border border-brass-light/60 bg-brass/40 sm:block"></span>
      <span aria-hidden="true" class="pointer-events-none absolute bottom-2 right-2 hidden h-2 w-2 rounded-full border border-brass-light/60 bg-brass/40 sm:block"></span>

      <!-- Heavy Cotton-Linen Speisekarte Sheet -->
      <div class="menu-sheet relative rounded-[4px] p-2.5 sm:p-4 md:p-6">
        <!-- Inner Double-Border Classic Trattoria Frame -->
        <div class="relative border border-brass/60 px-4 py-9 sm:px-9 sm:py-13 md:px-14 md:py-16">
          <!-- Decorative Italian Corner Squares (echoing Verdi's real printed brochure!) -->
          <span aria-hidden="true" class="pointer-events-none absolute -left-[5px] -top-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>
          <span aria-hidden="true" class="pointer-events-none absolute -right-[5px] -top-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>
          <span aria-hidden="true" class="pointer-events-none absolute -bottom-[5px] -left-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>
          <span aria-hidden="true" class="pointer-events-none absolute -bottom-[5px] -right-[5px] h-3.5 w-3.5 border border-walnut/70 bg-cream"></span>

          <!-- Classic Speisekarte Masthead -->
          <header class="reveal mx-auto max-w-2xl text-center">
            <div class="flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.32em] text-wood-warm">
              <span class="h-px w-8 bg-brass/70" aria-hidden="true"></span>
              <span>Ristorante · Pizzeria Verdi</span>
              <span class="h-px w-8 bg-brass/70" aria-hidden="true"></span>
            </div>

            <h2 class="mt-3 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
              Speisekarte
            </h2>

            <p class="mt-2 font-display text-xl italic text-tomato sm:text-2xl">
              „{RESTAURANT.tagline}“
            </p>

            <p class="mt-3 text-sm italic text-muted">
              {menuData.freshnessNote} · Telefonische Vorbestellung zur Abholung unter{' '}
              <a href={RESTAURANT.phoneHref} class="font-semibold not-italic text-ink underline decoration-brass/80 underline-offset-4 hover:text-tomato">
                {RESTAURANT.phoneDisplay}
              </a>
            </p>

            <!-- Ornamental Menu Divider -->
            <div class="mt-7 flex items-center justify-center gap-3 text-brass" aria-hidden="true">
              <span class="h-px w-20 bg-gradient-to-r from-transparent to-brass/70"></span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 0 10.2 5.8 16 8l-5.8 2.2L8 16l-2.2-5.8L0 8l5.8-2.2Z" />
              </svg>
              <span class="h-px w-20 bg-gradient-to-l from-transparent to-brass/70"></span>
            </div>
          </header>

          <!-- Empty search state -->
          <div
            id="menu-empty-state"
            hidden
            class="my-12 rounded-xl border border-dashed border-taupe bg-parchment/55 px-6 py-12 text-center"
          >
            <p class="font-display text-2xl italic text-ink">Keine passenden Gerichte gefunden.</p>
            <p class="mt-2 text-sm text-muted">
              Probieren Sie eine andere Zutat oder setzen Sie den Filter zurück.
            </p>
            <button
              type="button"
              id="menu-reset-btn"
              class="mt-5 rounded-full bg-walnut px-5 py-2 text-sm font-semibold text-cream transition-colors hover:bg-espresso"
            >
              Gesamte Speisekarte anzeigen
            </button>
          </div>

          <!-- Menu Chapters (Authentic Classic Print Spread) -->
          <div class="mt-12 space-y-16" id="menu-sections-wrapper">
            {menuData.categories.map((cat, catIdx) => (
              <section data-menu-category={cat.id} aria-labelledby={`cat-heading-${cat.id}`}>
                <!-- Centered Classic Chapter Header -->
                <div class="mb-8 text-center">
                  <p class="font-display text-sm italic tracking-[0.25em] text-brass">
                    — {romanNumerals[catIdx]} —
                  </p>
                  <h3
                    id={`cat-heading-${cat.id}`}
                    class="mt-1 font-display text-3xl font-semibold tracking-tight text-walnut sm:text-4xl"
                  >
                    {cat.title}
                  </h3>
                  <p class="mt-1 font-display text-base italic text-muted">{cat.subtitle}</p>
                  <div class="mx-auto mt-3 h-px w-28 bg-brass/45" aria-hidden="true"></div>
                </div>

                <!-- Two-Column Fine-Dining Open-Book List -->
                <ul class="relative grid gap-x-12 gap-y-5 md:grid-cols-2">
                  {cat.items.map((item) => (
                    <li
                      data-menu-item
                      data-veg={item.vegetarian ? 'true' : 'false'}
                      data-search={`${item.number} ${item.name} ${item.description}`.toLowerCase()}
                      class="group border-b border-sand/75 pb-3.5 transition-colors hover:border-brass/80"
                    >
                      <div class="flex items-baseline gap-2">
                        <span class="w-6 shrink-0 font-display text-sm italic text-wood-warm">
                          {item.number}.
                        </span>

                        <h4 class="font-display text-[1.22rem] font-semibold leading-snug text-ink transition-colors group-hover:text-tomato">
                          {item.name}
                        </h4>

                        {item.vegetarian && (
                          <span
                            title="Vegetarisch"
                            class="inline-flex shrink-0 items-center text-verdi"
                            aria-label="Vegetarisch"
                          >
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                            </svg>
                          </span>
                        )}

                        {item.highlight && (
                          <span class="shrink-0 font-display text-xs italic font-semibold tracking-wide text-tomato">
                            ★ {item.highlight}
                          </span>
                        )}

                        <span class="menu-leader mx-2 mb-1.5 hidden h-[2px] min-w-[16px] flex-1 self-end sm:block" aria-hidden="true"></span>

                        <span class="ml-auto shrink-0 font-display text-[1.2rem] font-bold tabular-nums text-ink">
                          {formatPrice(item.price)}
                        </span>
                      </div>

                      <div class="mt-0.5 flex items-baseline justify-between gap-4 pl-8">
                        <p class="text-[0.86rem] italic leading-relaxed text-muted">
                          {item.description}
                        </p>
                        {item.allergens && (
                          <span
                            class="shrink-0 text-[0.68rem] text-muted/75"
                            title={`Allergene / Zusatzstoffe: ${item.allergens}`}
                          >
                            ({item.allergens})
                          </span>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))}

            <!-- Classic Trattoria Footnote Box: Aufpreis je nach Wahl -->
            <section
              data-menu-category="extras"
              aria-labelledby="cat-heading-extras"
              class="overflow-hidden rounded-lg border border-wood-warm/30 bg-parchment/70 shadow-xs"
            >
              <div class="wood-warm-cap h-1.5 w-full" aria-hidden="true"></div>
              <div class="p-6 sm:p-8">
                <div class="text-center">
                  <p class="font-display text-xs italic uppercase tracking-[0.26em] text-wood-warm">
                    Aufpreis je nach Wahl
                  </p>
                  <h3 id="cat-heading-extras" class="mt-1 font-display text-3xl font-semibold text-walnut">
                    Zusätzliche Wunschbeläge
                  </h3>
                </div>

                <div class="mt-6 grid divide-y divide-sand md:grid-cols-3 md:divide-x md:divide-y-0">
                  {menuData.extras.map((tier) => (
                    <div class="px-4 py-4 text-center first:pt-0 md:py-2">
                      <p class="font-display text-2xl font-bold italic text-tomato tabular-nums">
                        + {formatPrice(tier.price)}
                      </p>
                      <p class="mt-2 text-sm italic leading-relaxed text-ink/85">{tier.items}</p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          </div>

          <!-- Classic Menu Footnote: Frischegarantie + Legend + Allergens -->
          <footer class="mt-12 border-t border-brass/45 pt-6">
            <div class="flex flex-wrap items-center justify-between gap-4 text-xs italic text-muted">
              <p class="flex items-center gap-2">
                <svg class="h-3.5 w-3.5 text-verdi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                </svg>
                <span>= Vegetarisch · ★ = Haus-Spezialität / Gäste-Favorit</span>
              </p>
              <p>Alle Preise in Euro inkl. MwSt. · Änderungen vorbehalten</p>
            </div>

            <details class="mt-5 border-t border-sand/85 pt-4 text-sm text-muted">
              <summary class="cursor-pointer font-display text-base font-semibold text-ink transition-colors hover:text-tomato">
                Hinweise zu Allergenen (a–n) &amp; Zusatzstoffen (1–13) öffnen
              </summary>
              <div class="mt-4 grid gap-6 border-t border-sand/75 pt-4 md:grid-cols-2">
                <div>
                  <h4 class="font-display text-sm font-bold uppercase tracking-wider text-walnut">Allergene</h4>
                  <dl class="mt-2 grid grid-cols-1 gap-1 text-xs sm:grid-cols-2">
                    {menuData.allergenLegend.map((a) => (
                      <div>
                        <dt class="inline font-bold text-ink">{a.code} =</dt>{' '}
                        <dd class="inline">{a.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div>
                  <h4 class="font-display text-sm font-bold uppercase tracking-wider text-walnut">Zusatzstoffe</h4>
                  <dl class="mt-2 space-y-1 text-xs">
                    {menuData.additiveLegend.map((z) => (
                      <div>
                        <dt class="inline font-bold text-ink">{z.code} =</dt>{' '}
                        <dd class="inline">{z.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            </details>
          </footer>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initMenuFilter() {
    const catButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-btn]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-category]'));
    const vegBtn = document.getElementById('veggie-toggle') as HTMLButtonElement | null;
    const searchInput = document.getElementById('menu-search') as HTMLInputElement | null;
    const emptyState = document.getElementById('menu-empty-state');
    const resetBtn = document.getElementById('menu-reset-btn');

    if (!catButtons.length || !sections.length) return;

    let activeCat = 'all';
    let vegOnly = false;
    let query = '';

    const applyFilter = () => {
      let visibleTotal = 0;

      sections.forEach((sec) => {
        const secCat = sec.dataset.menuCategory || '';
        const catMatches = activeCat === 'all' || activeCat === secCat;

        if (!catMatches) {
          sec.hidden = true;
          return;
        }

        if (secCat === 'extras') {
          const textMatches = !query || sec.textContent?.toLowerCase().includes(query);
          sec.hidden = !textMatches;
          if (!sec.hidden) visibleTotal += 1;
          return;
        }

        const items = Array.from(sec.querySelectorAll<HTMLElement>('[data-menu-item]'));
        let secVisible = 0;

        items.forEach((item) => {
          const isVeg = item.dataset.veg === 'true';
          const searchHaystack = item.dataset.search || '';
          const ok = (!vegOnly || isVeg) && (!query || searchHaystack.includes(query));
          item.hidden = !ok;
          if (ok) secVisible += 1;
        });

        sec.hidden = secVisible === 0;
        visibleTotal += secVisible;
      });

      if (emptyState) emptyState.hidden = visibleTotal > 0;
    };

    const setActiveButton = (targetCat: string) => {
      activeCat = targetCat;
      catButtons.forEach((btn) => {
        const selected = btn.dataset.catBtn === activeCat;
        btn.setAttribute('aria-selected', String(selected));
        btn.classList.toggle('bg-cream', selected);
        btn.classList.toggle('text-espresso', selected);
        btn.classList.toggle('font-bold', selected);
        btn.classList.toggle('shadow-xs', selected);
        btn.classList.toggle('bg-walnut/65', !selected);
        btn.classList.toggle('text-cream/90', !selected);
        btn.classList.toggle('font-semibold', !selected);
        btn.classList.toggle('border', !selected);
        btn.classList.toggle('border-brass/30', !selected);
      });
      applyFilter();
    };

    catButtons.forEach((btn) => {
      btn.onclick = () => setActiveButton(btn.dataset.catBtn || 'all');
    });

    if (vegBtn) {
      vegBtn.onclick = () => {
        vegOnly = !vegOnly;
        vegBtn.setAttribute('aria-pressed', String(vegOnly));
        vegBtn.classList.toggle('bg-verdi', vegOnly);
        vegBtn.classList.toggle('border-verdi', vegOnly);
        vegBtn.classList.toggle('text-cream', vegOnly);
        vegBtn.classList.toggle('bg-espresso/75', !vegOnly);
        vegBtn.classList.toggle('border-brass/35', !vegOnly);
        vegBtn.classList.toggle('text-cream/90', !vegOnly);
        applyFilter();
      };
    }

    if (searchInput) {
      searchInput.oninput = () => {
        query = searchInput.value.trim().toLowerCase();
        applyFilter();
      };
    }

    if (resetBtn) {
      resetBtn.onclick = () => {
        vegOnly = false;
        query = '';
        if (searchInput) searchInput.value = '';
        if (vegBtn) {
          vegBtn.setAttribute('aria-pressed', 'false');
          vegBtn.classList.remove('bg-verdi', 'border-verdi', 'text-cream');
          vegBtn.classList.add('bg-espresso/75', 'border-brass/35', 'text-cream/90');
        }
        setActiveButton('all');
      };
    }
  }

  document.addEventListener('astro:page-load', initMenuFilter);
</script>
