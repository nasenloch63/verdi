---
import VerdiLogo from './VerdiLogo.astro';
import { RESTAURANT } from '../data/restaurant';

interface Props {
  isSubpage?: boolean;
}
const { isSubpage = false } = Astro.props;
const prefix = isSubpage ? '/' : '';

const navLinks = [
  { label: 'Speisekarte', href: `${prefix}#speisekarte` },
  { label: 'Über uns', href: `${prefix}#ueber-uns` },
  { label: 'Bewertungen', href: `${prefix}#bewertungen` },
  { label: 'Galerie', href: `${prefix}#galerie` },
  { label: 'Besuch & Zeiten', href: `${prefix}#besuch` },
];
---

<header class="sticky top-0 z-40 border-b border-sand/80 bg-cream/92 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group focus-visible:outline-tomato" aria-label="Ristorante Verdi Pizzeria – Startseite">
      <VerdiLogo compact />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-7 lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-ink/85 transition-colors hover:text-tomato"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div
        data-live-status
        class="hidden items-center gap-2 rounded-full border border-sand bg-parchment/80 px-3 py-1.5 text-xs font-medium text-ink sm:inline-flex"
      >
        <span data-status-dot class="h-2 w-2 rounded-full bg-verdi"></span>
        <span data-status-text>Mo, Mi–So · 11–14:30 &amp; 17–21:30</span>
      </div>

      <a
        href={RESTAURANT.phoneHref}
        class="inline-flex items-center gap-2 rounded-full bg-tomato px-4 py-2 text-sm font-semibold text-cream shadow-sm transition-all hover:bg-tomato-dark active:scale-[0.98]"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span class="hidden sm:inline">{RESTAURANT.phoneDisplay}</span>
        <span class="sm:hidden">Anrufen</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Menü öffnen"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-sand bg-parchment text-ink transition-colors hover:border-ink/30 lg:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-nav-drawer"
    hidden
    class="border-t border-sand bg-cream px-4 pb-5 pt-3 shadow-lg lg:hidden"
  >
    <div
      data-live-status
      class="mb-3 inline-flex items-center gap-2 rounded-full border border-sand bg-parchment px-3 py-1.5 text-xs font-medium text-ink"
    >
      <span data-status-dot class="h-2 w-2 rounded-full bg-verdi"></span>
      <span data-status-text>Mo, Mi–So · 11–14:30 &amp; 17–21:30</span>
    </div>
    <nav aria-label="Mobile Navigation" class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-mobile-nav-link
          class="rounded-xl px-3 py-2.5 text-base font-medium text-ink transition-colors hover:bg-parchment hover:text-tomato"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function initMobileNav() {
    const btn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!btn || !drawer) return;

    const close = () => {
      drawer.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Menü öffnen');
    };

    btn.onclick = () => {
      const opening = drawer.hidden;
      drawer.hidden = !opening;
      btn.setAttribute('aria-expanded', String(opening));
      btn.setAttribute('aria-label', opening ? 'Menü schließen' : 'Menü öffnen');
    };

    drawer.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
      link.addEventListener('click', close);
    });
  }
  document.addEventListener('astro:page-load', initMobileNav);
</script>
