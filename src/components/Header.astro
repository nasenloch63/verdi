---
import VerdiLogo from './VerdiLogo.astro';
import Icon from './Icon.astro';
import { RESTAURANT } from '../data/restaurant';

interface Props {
  isSubpage?: boolean;
}
const { isSubpage = false } = Astro.props;
const prefix = isSubpage ? '/' : '';

const navLinks = [
  { num: 'I', label: 'Speisekarte', href: `${prefix}#speisekarte` },
  { num: 'II', label: 'Über uns', href: `${prefix}#ueber-uns` },
  { num: 'III', label: 'Bewertungen', href: `${prefix}#bewertungen` },
  { num: 'IV', label: 'Galerie', href: `${prefix}#galerie` },
  { num: 'V', label: 'Besuch & Zeiten', href: `${prefix}#besuch` },
];
---

<header class="wood-dark-bar sticky top-0 z-40 border-b border-brass/35 shadow-[0_8px_28px_rgba(14,8,4,0.34)]">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-3.5 py-3 sm:gap-4 sm:px-6 lg:px-8">
    <a href="/" class="group focus-visible:outline-brass-light" aria-label="Ristorante Verdi Pizzeria – Startseite">
      <VerdiLogo variant="light" compact />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-7 lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative text-[0.98rem] font-semibold text-cream/90 transition-colors hover:text-brass-light after:absolute after:-bottom-1.5 after:left-0 after:h-[2px] after:w-0 after:rounded-full after:bg-tomato after:transition-all after:duration-300 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <div
        data-live-status
        class="hidden items-center gap-2 text-sm font-medium text-cream/90 md:inline-flex"
      >
        <span data-status-dot class="h-2 w-2 rounded-full bg-status-open"></span>
        <span data-status-text>Mo, Mi–So · 11–14:30 &amp; 17–21:30</span>
      </div>

      <a
        href={RESTAURANT.phoneHref}
        class="btn btn-sm btn-primary"
      >
        <Icon name="phone" size={17} />
        <span class="hidden sm:inline">{RESTAURANT.phoneDisplay}</span>
        <span class="sm:hidden">Anrufen</span>
      </a>

      <!-- Morphing Hamburger -> X Toggle Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Menü öffnen"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-cream transition-colors hover:bg-cream/10 lg:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line class="burger-line burger-top" x1="4" y1="7" x2="20" y2="7" />
          <line class="burger-line burger-mid" x1="4" y1="12" x2="20" y2="12" />
          <line class="burger-line burger-bot" x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Smooth Animated Dark-Walnut Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    data-open="false"
    aria-hidden="true"
    class="mobile-drawer wood-dark-surface border-t border-brass/30 shadow-2xl lg:hidden"
  >
    <div class="mobile-drawer-inner">
      <div class="mx-auto max-w-7xl px-5 pb-6 pt-4">
        <div
          data-live-status
          style="--stagger: 35ms"
          class="mobile-nav-item mb-3 flex items-center gap-2 text-sm font-medium text-cream/90"
        >
          <span data-status-dot class="h-2 w-2 rounded-full bg-status-open"></span>
          <span data-status-text>Mo, Mi–So · 11–14:30 &amp; 17–21:30</span>
        </div>

        <nav aria-label="Mobile Navigation" class="divide-y divide-brass/20">
          {navLinks.map((link, idx) => (
            <a
              href={link.href}
              data-mobile-nav-link
              style={`--stagger: ${75 + idx * 55}ms`}
              class="mobile-nav-item group flex items-baseline justify-between py-3.5 text-cream transition-colors hover:text-brass-light"
            >
              <span class="flex items-baseline gap-3.5">
                <span class="w-6 font-display text-sm italic text-brass-light">{link.num}.</span>
                <span class="font-display text-2xl font-semibold tracking-tight">{link.label}</span>
              </span>
              <svg
                class="h-4 w-4 text-sand/75 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-brass-light"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </nav>

        <div
          style="--stagger: 360ms"
          class="mobile-nav-item mt-5 flex items-center justify-between gap-3 border-t border-brass/20 pt-4 text-sm text-sand"
        >
          <span>{RESTAURANT.street} · {RESTAURANT.city}</span>
          <a href={RESTAURANT.phoneHref} class="shrink-0 font-semibold text-brass-light underline decoration-brass/50 underline-offset-2 hover:text-cream">
            {RESTAURANT.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileNav() {
    const btn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!btn || !drawer) return;

    const setOpen = (open: boolean) => {
      drawer.dataset.open = String(open);
      drawer.setAttribute('aria-hidden', String(!open));
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    };

    btn.onclick = () => {
      const isOpen = drawer.dataset.open === 'true';
      setOpen(!isOpen);
    };

    drawer.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.dataset.open === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
  }
  document.addEventListener('astro:page-load', initMobileNav);
</script>
