---
import VerdiLogo from './VerdiLogo.astro';
import { RESTAURANT } from '../data/restaurant';

const year = new Date().getFullYear();
---

<footer class="wood-dark-surface relative mt-auto border-t-2 border-brass/50 pb-24 pt-16 text-cream lg:pb-12">
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 border-b border-brass/25 pb-12 md:grid-cols-12">
      <!-- Brand Column -->
      <div class="md:col-span-5">
        <a href="/" aria-label="Ristorante Verdi Startseite">
          <VerdiLogo variant="light" />
        </a>
        <p class="mt-4 max-w-sm font-display text-base italic text-brass-light">
          „{RESTAURANT.tagline}“
        </p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-parchment/80">
          Steinofen-Pizza, frische Pasta, Pasta al Forno und knackige Salate in Hessisch Lichtenau –
          vor Ort genießen oder telefonisch vorbestellen und heiß abholen.
        </p>
      </div>

      <!-- Contact Column -->
      <div class="md:col-span-4">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-brass-light">Kontakt &amp; Adresse</h2>
        <address class="mt-4 space-y-2 text-sm not-italic text-parchment/90">
          <p>{RESTAURANT.street} ({RESTAURANT.landmark})</p>
          <p>{RESTAURANT.postalCode} {RESTAURANT.city}</p>
          <p class="pt-1">
            Telefon:{' '}
            <a href={RESTAURANT.phoneHref} class="font-semibold text-cream underline decoration-brass/60 underline-offset-4 transition-colors hover:text-brass-light">
              {RESTAURANT.phoneDisplay}
            </a>
          </p>
          <p class="text-xs text-sand/80">
            Mo, Mi–So: 11:00–14:30 &amp; 17:00–21:30 · Di Ruhetag
          </p>
        </address>
      </div>

      <!-- Links Column -->
      <div class="md:col-span-3">
        <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-brass-light">Links &amp; Rechtliches</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-parchment/90">
          <li>
            <a href="/#speisekarte" class="transition-colors hover:text-brass-light">Speisekarte</a>
          </li>
          <li>
            <a href={RESTAURANT.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-brass-light">
              Google Maps &amp; Bewertungen
            </a>
          </li>
          <li>
            <a href={RESTAURANT.facebookUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-brass-light">
              Facebook-Seite
            </a>
          </li>
          <li class="border-t border-brass/20 pt-2">
            <a href="/impressum" class="transition-colors hover:text-brass-light">Impressum</a>
          </li>
          <li>
            <a href="/datenschutz" class="transition-colors hover:text-brass-light">Datenschutzerklärung</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 text-xs text-sand/80 sm:flex-row sm:items-center">
      <p>© {year} {RESTAURANT.name} · Hessisch Lichtenau</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>Ohne Cookies &amp; ohne Tracking</span>
        <span aria-hidden="true" class="text-brass/50">·</span>
        <span class="font-medium text-parchment">
          Design &amp; Entwicklung by <strong class="font-semibold text-brass-light">Naser Solutions</strong>
        </span>
      </p>
    </div>
  </div>
</footer>
