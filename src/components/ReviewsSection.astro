---
import Icon from './Icon.astro';
import { RESTAURANT, REVIEWS } from '../data/restaurant';

const fiveStarShare = Math.round((RESTAURANT.rating.fiveStarCount / RESTAURANT.rating.count) * 100);
const avatarColors = ['#A93320', '#37563B', '#5E402B', '#B4823E', '#243B27', '#892516'];
const tilts = ['-1.6deg', '1.2deg', '-0.8deg', '1.8deg', '-1.3deg', '0.9deg'];
const modeInfo = {
  'vor-ort': { icon: 'utensils', text: 'hat vor Ort gegessen' },
  mitnehmen: { icon: 'bag', text: 'hat zum Mitnehmen bestellt' },
} as const;

// Wraps the chosen phrase of a quote in a marker highlight
const splitQuote = (quote: string, highlight: string) => {
  const i = quote.indexOf(highlight);
  if (i < 0) return { before: quote, mark: '', after: '' };
  return { before: quote.slice(0, i), mark: highlight, after: quote.slice(i + highlight.length) };
};
const initial = (name: string) => name.trim().charAt(0).toUpperCase();
const [lead, ...rest] = REVIEWS;
const leadParts = splitQuote(lead.quote, lead.highlight);
---

<section id="bewertungen" class="wood-dark-surface relative scroll-mt-20 overflow-hidden border-y border-brass/40 py-20 text-cream sm:py-28">
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- The score, big and honest, with the way to all reviews -->
      <div class="min-w-0 lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="kicker kicker-light">Das sagen unsere Gäste</p>
          <h2 data-split class="mt-1 font-display text-4xl font-medium leading-[1.04] tracking-tight text-cream sm:text-[3.2rem]">
            Wer einmal da war, <span class="italic font-normal text-parchment">kommt wieder.</span>
          </h2>

          <div class="reveal mt-9">
            <div class="flex items-end gap-4">
              <span
                class="font-display text-[6.5rem] font-medium leading-[0.8] tracking-tight text-cream sm:text-[7.5rem]"
                data-count-to={RESTAURANT.rating.score}
                data-count-decimals="1"
                data-count-display={RESTAURANT.rating.scoreDisplay}
              >
                {RESTAURANT.rating.scoreDisplay}
              </span>
              <span class="pb-1.5">
                <span class="flex gap-1 text-brass-light" role="img" aria-label={`${RESTAURANT.rating.scoreDisplay} von 5 Sternen`}>
                  {Array.from({ length: 5 }).map(() => <Icon name="star" size={24} />)}
                </span>
                <span class="mt-1.5 block text-base text-parchment/90">von 5 Sternen bei Google</span>
              </span>
            </div>

            <div class="mt-7">
              <div class="flex items-baseline justify-between gap-3 text-[0.95rem] text-parchment/90">
                <span>
                  <strong class="font-bold text-cream">{RESTAURANT.rating.fiveStarCount}</strong> von {RESTAURANT.rating.count} Gästen gaben volle 5 Sterne
                </span>
                <span class="font-display text-lg text-brass-light">{fiveStarShare}&nbsp;%</span>
              </div>
              <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-cream/12">
                <div data-bar class="h-full origin-left rounded-full bg-gradient-to-r from-brass to-brass-light" style={`width: ${fiveStarShare}%`}></div>
              </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
              <a href={RESTAURANT.phoneHref} class="btn btn-primary">
                <Icon name="phone" size={19} />
                <span>Jetzt bestellen</span>
              </a>
              <a href={RESTAURANT.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-line-light">
                <span>Alle {RESTAURANT.rating.count} lesen</span>
                <Icon name="arrow-up-right" size={17} />
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Guest notes: paper cards pinned to the walnut wall -->
      <div class="min-w-0 lg:col-span-8" data-marker-group>
        <figure data-note class="guest-note px-6 py-7 sm:px-10 sm:py-9" style="--tilt: -0.7deg">
          <span class="tape" aria-hidden="true"></span>
          <Icon name="quote" size={44} class="text-tomato/85" />
          <blockquote class="mt-3 font-display text-[1.55rem] font-normal leading-[1.28] text-ink sm:text-[2.15rem]">
            {leadParts.before}<mark class="marker">{leadParts.mark}</mark>{leadParts.after}
          </blockquote>
          <figcaption class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <span class="flex items-center gap-3">
              <span class="guest-avatar" style={`--avatar: ${avatarColors[0]}`} aria-hidden="true">{initial(lead.author)}</span>
              <span class="leading-tight">
                <span class="block text-base font-bold text-ink">{lead.author}</span>
                {lead.mode && (
                  <span class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
                    <Icon name={modeInfo[lead.mode].icon} size={15} />
                    {modeInfo[lead.mode].text}
                  </span>
                )}
              </span>
            </span>
            <span class="flex items-center gap-2 text-sm font-semibold text-muted">
              <span class="flex gap-0.5 text-brass" role="img" aria-label={`${lead.rating} von 5 Sternen`}>
                {Array.from({ length: lead.rating }).map(() => <Icon name="star" size={17} />)}
              </span>
              <span>Google-Rezension</span>
            </span>
          </figcaption>
        </figure>

        <div class="no-scrollbar -mx-4 mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 pt-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-x-7 sm:gap-y-9 sm:overflow-visible sm:px-0 sm:pb-0">
          {rest.map((review, i) => {
            const parts = splitQuote(review.quote, review.highlight);
            return (
              <figure
                data-note
                class="guest-note flex w-[84vw] max-w-sm shrink-0 snap-center flex-col justify-between px-6 py-6 sm:w-auto sm:max-w-none"
                style={`--tilt: ${tilts[(i + 1) % tilts.length]}`}
              >
                <div>
                  <span class="flex gap-0.5 text-brass" role="img" aria-label={`${review.rating} von 5 Sternen`}>
                    {Array.from({ length: review.rating }).map(() => <Icon name="star" size={18} />)}
                  </span>
                  <blockquote class="mt-3.5 text-[1.06rem] leading-relaxed text-ink/90">
                    „{parts.before}<mark class="marker font-semibold text-ink">{parts.mark}</mark>{parts.after}“
                  </blockquote>
                </div>
                <figcaption class="mt-5 flex items-center gap-3 border-t border-sand/80 pt-4">
                  <span class="guest-avatar" style={`--avatar: ${avatarColors[(i + 1) % avatarColors.length]}`} aria-hidden="true">
                    {initial(review.author)}
                  </span>
                  <span class="leading-tight">
                    <span class="block text-base font-bold text-ink">{review.author}</span>
                    <span class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
                      {review.mode ? (
                        <>
                          <Icon name={modeInfo[review.mode].icon} size={15} />
                          {modeInfo[review.mode].text}
                        </>
                      ) : (
                        'Google-Rezension'
                      )}
                    </span>
                  </span>
                </figcaption>
              </figure>
            );
          })}
        </div>

        <!-- Required transparency (§ 5b Abs. 3 UWG): placed right beside the reviews -->
        <p class="mt-7 max-w-2xl text-sm leading-relaxed text-parchment/75">
          Wörtliche Auszüge aus öffentlichen Google-Rezensionen zu unserem Restaurant, Nachnamen abgekürzt.
          Wir prüfen nicht, ob die Verfasserinnen und Verfasser tatsächlich bei uns zu Gast waren.{' '}
          <a href={RESTAURANT.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="link-draw whitespace-nowrap text-brass-light hover:text-cream">
            Alle Rezensionen bei Google
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
