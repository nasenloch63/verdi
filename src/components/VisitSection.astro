---
import Icon from './Icon.astro';
import { RESTAURANT, OPENING_HOURS, AMENITIES } from '../data/restaurant';
// Own vector map, generated once from OpenStreetMap data (scripts/build-map.cjs).
// It ships with the page: no tiles, no third-party request, no cookie, no consent dialog.
import mapSvg from '../assets/map/verdi-lageplan.svg?raw';
---

<section id="besuch" class="bg-surface-taupe relative scroll-mt-20 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="kicker">Kommen Sie vorbei</p>
      <h2 data-split class="mt-1 font-display text-4xl font-medium tracking-tight text-ink sm:text-[3.4rem] sm:leading-[1.02]">
        So finden Sie <span class="italic font-normal text-wood-warm">zu uns</span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/85">
        Mitten in Hessisch Lichtenau an der <strong class="font-semibold text-ink">{RESTAURANT.street}</strong>,{' '}
        {RESTAURANT.landmark}. Parken können Sie kostenlos direkt vor der Tür.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-12">
      <!-- The map: drawn in the house colours, visible at once -->
      <div class="reveal lg:col-span-7">
        <div
          data-map
          class="relative overflow-hidden rounded-xl border-[6px] border-[#fbf7f0] bg-[#fbf7f0] shadow-[0_30px_60px_-28px_rgba(20,11,6,0.6),0_3px_10px_rgba(20,11,6,0.14)]"
        >
          <div class="relative aspect-[4/3.1] overflow-hidden sm:aspect-[16/10.5]">
          <Fragment set:html={mapSvg} />

          <span class="map-ring" aria-hidden="true"></span>
          <span class="map-ring" aria-hidden="true"></span>
          <div class="map-pin" aria-hidden="true">
            <svg width="54" height="68" viewBox="0 0 54 68" fill="none">
              <path d="M27 66S4 44.500 4 26a23 23 0 0 1 46 0c0 18.500-23 40-23 40z" fill="#A93320" stroke="#fbf7f0" stroke-width="3" />
              <circle cx="27" cy="26" r="14" fill="#fbf7f0" />
              <circle cx="27" cy="26" r="6.500" fill="#A93320" />
            </svg>
          </div>

          <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener noreferrer"
            class="absolute right-0 top-0 z-10 rounded-bl-md bg-[#fbf7f0]/90 px-2 py-1 text-[0.72rem] text-muted hover:text-ink"
          >
            © OpenStreetMap-Mitwirkende
          </a>
          </div>

          <!-- Address ticket with the two things people do next: below the map on phones, laid over it from tablet up -->
          <div class="relative z-10 flex flex-col gap-3 px-3 pb-3 pt-4 sm:absolute sm:bottom-4 sm:left-4 sm:max-w-[22rem] sm:rounded-lg sm:bg-[#fbf7f0]/96 sm:p-5 sm:shadow-[0_14px_30px_-14px_rgba(20,11,6,0.55)]">
            <div class="flex items-start gap-3">
              <Icon name="pin" size={28} class="mt-0.5 text-tomato [--ic-accent:#A93320]" />
              <p class="leading-snug">
                <span class="block font-display text-xl font-medium text-ink">{RESTAURANT.shortName}</span>
                <span class="text-[0.98rem] text-muted">
                  {RESTAURANT.street}, {RESTAURANT.postalCode} {RESTAURANT.city}
                </span>
              </p>
            </div>
            <div class="flex gap-2.5">
              <a href={RESTAURANT.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary flex-1">
                <Icon name="route" size={18} />
                <span>Route planen</span>
              </a>
              <a href={RESTAURANT.phoneHref} class="btn btn-sm btn-line-dark flex-1">
                <Icon name="phone" size={17} />
                <span>Anrufen</span>
              </a>
            </div>
          </div>
        </div>
        <p class="mt-3 flex items-center gap-2 text-sm text-muted">
          <Icon name="basil" size={18} class="text-verdi [--ic-accent:#4a8a55]" />
          Unsere eigene Karte: lädt ohne Cookies und ohne Verbindung zu Google.
        </p>
      </div>

      <!-- Opening hours -->
      <div class="reveal linen-card flex flex-col justify-between rounded-xl border border-sand lg:col-span-5">
        <div class="px-6 pt-7 sm:px-8">
          <div class="flex items-center gap-3.5">
            <span class="medallion h-14 w-14">
              <Icon name="clock" size={30} />
            </span>
            <div>
              <h3 class="font-display text-[1.75rem] font-medium leading-none text-ink">Öffnungszeiten</h3>
              <p data-live-status class="mt-2 flex items-center gap-2 text-[0.98rem] font-semibold text-ink">
                <span data-status-dot class="h-2.5 w-2.5 rounded-full bg-status-open"></span>
                <span data-status-text>Mo, Mi–So geöffnet</span>
              </p>
            </div>
          </div>

          <dl class="mt-6 text-base">
            {OPENING_HOURS.map((day) => (
              <div
                data-day-index={day.dayIndex}
                class="flex items-center justify-between gap-4 border-b border-sand/70 px-2.5 py-2.5 transition-colors last:border-b-0"
              >
                <dt class="flex items-baseline gap-2.5 text-ink">
                  <span>{day.label}</span>
                  <span data-today-badge class="font-hand hidden -rotate-3 text-[1.35rem] leading-none text-tomato">heute</span>
                </dt>
                <dd class={`flex flex-col items-end whitespace-nowrap tabular-nums leading-snug sm:flex-row sm:gap-3 ${day.closed ? 'font-semibold text-tomato' : 'text-muted'}`}>
                  {day.closed ? 'Ruhetag' : day.slots.map((s) => <span>{s.open}–{s.close}</span>)}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="mt-6 flex items-start gap-3 rounded-b-xl border-t border-sand bg-parchment/60 px-6 py-5 sm:px-8">
          <span class="font-hand -rotate-3 text-[1.6rem] leading-none text-tomato">Tipp:</span>
          <p class="text-[0.95rem] leading-relaxed text-ink/90">{RESTAURANT.peakHint}</p>
        </div>
      </div>
    </div>

    <!-- What to expect on site, in plain words -->
    <ul data-stagger-group class="mt-14 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {AMENITIES.map((item) => (
        <li data-stagger-item class="flex items-start gap-4">
          <span class="medallion h-14 w-14">
            <Icon name={item.icon} size={30} />
          </span>
          <span>
            <span class="block font-display text-[1.25rem] font-medium leading-tight text-walnut">{item.title}</span>
            <span class="mt-1 block text-base leading-relaxed text-muted">{item.detail}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
