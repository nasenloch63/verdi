---
import Icon from './Icon.astro';
import { RESTAURANT } from '../data/restaurant';
---

<!-- Fixed bottom bar on phones and small tablets: the three things guests do most -->
<div
  class="wood-dark-bar fixed inset-x-0 bottom-0 z-40 border-t border-brass/40 px-3 pb-[max(0.6rem,env(safe-area-inset-bottom))] pt-2 shadow-[0_-10px_28px_rgba(14,8,4,0.45)] lg:hidden"
  role="region"
  aria-label="Schnellzugriff: Anrufen, Route und Speisekarte"
>
  <div class="mx-auto flex max-w-md items-stretch gap-2">
    <a href={RESTAURANT.phoneHref} class="btn btn-sm btn-primary flex-[1.5] py-3">
      <Icon name="phone" size={18} />
      <span>Anrufen</span>
    </a>
    <a
      href={RESTAURANT.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[0.8rem] font-semibold text-cream active:bg-cream/10"
    >
      <Icon name="route" size={20} class="text-brass-light" />
      <span>Route</span>
    </a>
    <a
      href="#speisekarte"
      class="flex flex-1 flex-col items-center justify-center gap-0.5 rounded-lg text-[0.8rem] font-semibold text-cream active:bg-cream/10"
    >
      <Icon name="book" size={20} class="text-brass-light" />
      <span>Karte</span>
    </a>
  </div>
</div>
